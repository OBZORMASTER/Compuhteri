---

---

<section class="cart-page">
    <div class="container">
        <!-- Шапка сторінки -->
        <div class="cart-page-header">
            <h1 class="page-title">
                Ваш кошик <span class="cart-items-badge" id="header-items-badge">2</span>
            </h1>
            <button type="button" class="btn-clear-cart" id="btn-clear-cart" title="Видалити всі товари з кошика">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>Очистити кошик</span>
            </button>
        </div>

        <!-- Плашка безкоштовної доставки -->
        <div class="free-shipping-banner" id="free-shipping-banner">
            <div class="banner-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
            </div>
            <div class="banner-body">
                <div class="banner-info">
                    <span class="banner-title" id="shipping-banner-title">Вам доступна безкоштовна доставка! 🎉</span>
                    <span class="banner-desc" id="shipping-banner-desc">Замовлення від 20 000 ₴ доставляються безкоштовно у відділення Нової Пошти</span>
                </div>
                <div class="banner-progress-wrap">
                    <div class="banner-progress-bar" id="shipping-progress-bar" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- Шаблон для динамічного додавання товарів у кошик -->
        <template id="cart-item-template">
            <div class="cart-item">
                <a href="#" class="item-img-link">
                    <img src="" alt="" class="item-img" />
                </a>
                <div class="item-info">
                    <a href="#" class="item-title"></a>
                    <span class="item-code"></span>
                    <span class="item-stock">В наявності</span>
                </div>
                <div class="item-quantity">
                    <button type="button" class="qty-btn minus" aria-label="Зменшити">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><line x1="5" y1="12" x2="19" y2="12"></line></svg
                        >
                    </button>
                    <input
                        type="text"
                        value="1"
                        class="qty-input"
                        readonly
                    />
                    <button type="button" class="qty-btn plus" aria-label="Збільшити">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg
                        >
                    </button>
                </div>
                <div class="item-price"></div>
                <button type="button" class="item-remove" aria-label="Видалити" title="Видалити товар">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><polyline points="3 6 5 6 21 6"></polyline><path
                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                        ></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg
                    >
                </button>
            </div>
        </template>

        <!-- Основний лейаут -->
        <div class="cart-layout" id="cart-layout">
            <!-- Ліва частина: Список товарів -->
            <div class="cart-main-col">
                <div class="cart-items" id="cart-items-container">
                    <!-- Товар 1 -->
                    <div class="cart-item" data-id="item-1" data-price="64999">
                        <a href="/catalog/pc-cyber-neon" class="item-img-link">
                            <img
                                src="https://images.unsplash.com/photo-1587831990711-23ca6441447b?auto=format&fit=crop&q=80&w=200&h=200"
                                alt="ПК Cyber Neon"
                                class="item-img"
                            />
                        </a>
                        <div class="item-info">
                            <a href="/catalog/pc-cyber-neon" class="item-title"
                                >Ігровий ПК "Cyber Neon" (RTX 4070, i5-13600K)</a
                            >
                            <span class="item-code">Код: 902341</span>
                            <span class="item-stock">В наявності</span>
                        </div>
                        <div class="item-quantity">
                            <button type="button" class="qty-btn minus" aria-label="Зменшити">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><line x1="5" y1="12" x2="19" y2="12"
                                    ></line></svg
                                >
                            </button>
                            <input
                                type="text"
                                value="1"
                                class="qty-input"
                                readonly
                            />
                            <button type="button" class="qty-btn plus" aria-label="Збільшити">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><line x1="12" y1="5" x2="12" y2="19"
                                    ></line><line x1="5" y1="12" x2="19" y2="12"
                                    ></line></svg
                                >
                            </button>
                        </div>
                        <div class="item-price" data-single-price="64999">64 999 ₴</div>
                        <button type="button" class="item-remove" aria-label="Видалити" title="Видалити товар">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><polyline points="3 6 5 6 21 6"></polyline><path
                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                ></path><line x1="10" y1="11" x2="10" y2="17"
                                ></line><line x1="14" y1="11" x2="14" y2="17"
                                ></line></svg
                            >
                        </button>
                    </div>

                    <!-- Товар 2 -->
                    <div class="cart-item" data-id="item-2" data-price="18500">
                        <a href="/catalog/gpu-rtx-4060-ti" class="item-img-link">
                            <img
                                src="https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&q=80&w=200&h=200"
                                alt="Відеокарта RTX 4060 Ti"
                                class="item-img"
                            />
                        </a>
                        <div class="item-info">
                            <a href="/catalog/gpu-rtx-4060-ti" class="item-title"
                                >Відеокарта NVIDIA GeForce RTX 4060 Ti</a
                            >
                            <span class="item-code">Код: 120556</span>
                            <span class="item-stock">В наявності</span>
                        </div>
                        <div class="item-quantity">
                            <button type="button" class="qty-btn minus" aria-label="Зменшити">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><line x1="5" y1="12" x2="19" y2="12"
                                    ></line></svg
                                >
                            </button>
                            <input
                                type="text"
                                value="1"
                                class="qty-input"
                                readonly
                            />
                            <button type="button" class="qty-btn plus" aria-label="Збільшити">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><line x1="12" y1="5" x2="12" y2="19"
                                    ></line><line x1="5" y1="12" x2="19" y2="12"
                                    ></line></svg
                                >
                            </button>
                        </div>
                        <div class="item-price" data-single-price="18500">18 500 ₴</div>
                        <button type="button" class="item-remove" aria-label="Видалити" title="Видалити товар">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><polyline points="3 6 5 6 21 6"></polyline><path
                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                ></path><line x1="10" y1="11" x2="10" y2="17"
                                ></line><line x1="14" y1="11" x2="14" y2="17"
                                ></line></svg
                            >
                        </button>
                    </div>
                </div>

                <!-- Рекомендовані супутні аксесуари (Cross-sell) -->
                <div class="cart-cross-sell">
                    <h3 class="cross-sell-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                        Рекомендуємо додати до ПК
                    </h3>
                    <div class="cross-sell-grid">
                        <div class="cross-item">
                            <div class="cross-img-wrap">
                                <img src="https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?auto=format&fit=crop&q=80&w=200&h=200" alt="Килимок HyperX" class="cross-img" />
                            </div>
                            <div class="cross-info">
                                <span class="cross-name" title="Ігровий килимок HyperX Pulsefire XL">Ігровий килимок HyperX XL</span>
                                <span class="cross-price">699 ₴</span>
                            </div>
                            <button type="button" class="btn-cross-add" data-id="cross-1" data-name="Ігровий килимок HyperX Pulsefire XL" data-price="699" data-code="403912" data-img="https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?auto=format&fit=crop&q=80&w=200&h=200">
                                + Додати
                            </button>
                        </div>
                        <div class="cross-item">
                            <div class="cross-img-wrap">
                                <img src="https://images.unsplash.com/photo-1598331668826-20cecc596b86?auto=format&fit=crop&q=80&w=200&h=200" alt="Кабель DisplayPort" class="cross-img" />
                            </div>
                            <div class="cross-info">
                                <span class="cross-name" title="Кабель DisplayPort 1.4 8K (2 метри)">Кабель DisplayPort 1.4 8K</span>
                                <span class="cross-price">449 ₴</span>
                            </div>
                            <button type="button" class="btn-cross-add" data-id="cross-2" data-name="Кабель DisplayPort 1.4 8K (2 метри)" data-price="449" data-code="819203" data-img="https://images.unsplash.com/photo-1598331668826-20cecc596b86?auto=format&fit=crop&q=80&w=200&h=200">
                                + Додати
                            </button>
                        </div>
                        <div class="cross-item">
                            <div class="cross-img-wrap">
                                <img src="https://images.unsplash.com/photo-1587202372634-32705e3bf49c?auto=format&fit=crop&q=80&w=200&h=200" alt="Термопаста Arctic" class="cross-img" />
                            </div>
                            <div class="cross-info">
                                <span class="cross-name" title="Термопаста Arctic MX-4 (4г зі скребком)">Термопаста Arctic MX-4 (4г)</span>
                                <span class="cross-price">249 ₴</span>
                            </div>
                            <button type="button" class="btn-cross-add" data-id="cross-3" data-name="Термопаста Arctic MX-4 (4г зі скребком)" data-price="249" data-code="310294" data-img="https://images.unsplash.com/photo-1587202372634-32705e3bf49c?auto=format&fit=crop&q=80&w=200&h=200">
                                + Додати
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Права частина: Підсумок -->
            <aside class="cart-summary">
                <h3 class="summary-title">Разом</h3>

                <div class="summary-details">
                    <div class="summary-row">
                        <span class="row-label" id="summary-items-label">2 товари на суму</span>
                        <span class="row-value" id="summary-items-sum">83 499 ₴</span>
                    </div>
                    <div class="summary-row" id="discount-row">
                        <span class="row-label">Знижка</span>
                        <span class="row-value discount" id="summary-discount-val">0 ₴</span>
                    </div>
                    <div class="summary-row delivery-row">
                        <span class="row-label">Вартість доставки</span>
                        <span class="row-value delivery-status" id="summary-delivery-val">
                            За тарифами перевізника
                            <small class="free-delivery-badge">Безкоштовно від 20 000 ₴</small>
                        </span>
                    </div>
                </div>

                <!-- Поле для промокоду зі стрілочкою (Accordion) -->
                <div class="promo-accordion" id="promo-accordion">
                    <button type="button" class="promo-toggle" id="promo-toggle" aria-expanded="false">
                        <span class="promo-toggle-label">
                            <svg class="promo-tag-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                <line x1="7" y1="7" x2="7.01" y2="7"></line>
                            </svg>
                            <span>Маєте промокод?</span>
                        </span>
                        <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="promo-panel" id="promo-panel">
                        <div class="promo-input-group">
                            <input
                                type="text"
                                class="promo-input"
                                id="promo-input"
                                placeholder="Введіть промокод"
                                maxlength="20"
                                autocomplete="off"
                            />
                            <button type="button" class="btn-apply-promo" id="btn-apply-promo">Застосувати</button>
                        </div>
                        <div class="promo-hint">Підказка: натисніть <button type="button" class="code-chip" id="code-chip">PCSTORE</button> (-5%)</div>
                        <div class="promo-feedback" id="promo-feedback"></div>
                        <div class="promo-active-chip" id="promo-active-chip" style="display: none;">
                            <span class="chip-name" id="chip-name">PCSTORE</span>
                            <span class="chip-save" id="chip-save">-5%</span>
                            <button type="button" class="chip-remove" id="btn-remove-promo" title="Скасувати промокод">✕</button>
                        </div>
                    </div>
                </div>

                <!-- Додаткові послуги -->
                <div class="cart-services">
                    <div class="service-item included">
                        <span class="service-check">✓</span>
                        <span class="service-info">
                            <strong>Броньоване пакування</strong>
                            <small>0 ₴ (за наш рахунок)</small>
                        </span>
                    </div>
                    <label class="service-item selectable" for="addon-warranty">
                        <input type="checkbox" id="addon-warranty" class="service-checkbox" />
                        <span class="custom-check"></span>
                        <span class="service-info">
                            <strong>Додаткова гарантія +1 рік</strong>
                            <small>+1 499 ₴</small>
                        </span>
                    </label>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-total">
                    <span class="total-label">До сплати:</span>
                    <span class="total-price" id="summary-total-price">83 499 ₴</span>
                </div>

                <button type="button" class="btn btn-primary btn-checkout" id="btn-checkout">Оформити замовлення</button>
                <button type="button" class="btn btn-quick-order" id="btn-quick-order">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                    Швидке замовлення в 1 клік
                </button>
                <a href="/catalog" class="btn btn-outline btn-continue">Продовжити покупки</a>

                <!-- Блок гарантій та надійності -->
                <div class="summary-guarantees">
                    <div class="guarantee-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        <span>Офіційна гарантія до 36 місяців</span>
                    </div>
                    <div class="guarantee-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                        <span>14 днів на легкий обмін або повернення</span>
                    </div>
                    <div class="guarantee-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                        <span>Огляд та стрес-тест перед оплатою</span>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Порожній стан кошика (коли всі товари видалено) -->
        <div class="cart-empty-state" id="cart-empty-state" style="display: none;">
            <div class="empty-icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <h2 class="empty-title">Ваш кошик порожній</h2>
            <p class="empty-desc">Схоже, ви ще не додали жодного комп'ютера чи комплектуючої. Перегляньте наш каталог або скористайтеся конфігуратором ПК!</p>
            <div class="empty-actions">
                <a href="/catalog" class="btn btn-primary">Перейти до каталогу</a>
                <a href="/configurator" class="btn btn-outline">Зібрати свій ПК</a>
            </div>
        </div>

        <!-- Модалка: Швидке замовлення в 1 клік -->
        <div class="modal-backdrop" id="quick-order-modal" style="display: none;">
            <div class="modal-box">
                <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Закрити">✕</button>
                <div class="modal-header">
                    <div class="modal-badge-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <h3 class="modal-title">Швидке замовлення в 1 клік</h3>
                    <p class="modal-desc">Залиште свій номер телефону, і наш менеджер зателефонує вам протягом 10 хвилин для підтвердження деталей.</p>
                </div>
                <form id="quick-order-form" class="modal-form">
                    <div class="form-field">
                        <label for="quick-phone" class="field-label">Номер телефону *</label>
                        <input type="tel" id="quick-phone" class="field-input" placeholder="+380 (__) ___-__-__" required />
                    </div>
