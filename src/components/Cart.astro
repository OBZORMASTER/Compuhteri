        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 20px;
    }

    .modal-box {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        width: 100%;
        max-width: 460px;
        padding: 30px;
        position: relative;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        animation: modalFadeIn 0.25s ease-out;
    }

    @keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .modal-close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: transparent;
        border: none;
        color: var(--color-text-muted);
        font-size: 18px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: color 0.2s;
    }

    .modal-close-btn:hover {
        color: #ff5050;
    }

    .modal-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .modal-badge-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background-color: rgba(0, 255, 204, 0.15);
        color: var(--color-accent);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

    .modal-title {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .modal-desc {
        font-size: 13px;
        color: var(--color-text-muted);
        line-height: 1.5;
    }

    .modal-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        text-align: left;
    }

    .field-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-main);
    }

    .field-input {
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 12px 14px;
        color: var(--color-text-main);
        font-size: 15px;
    }

    .field-input:focus {
        outline: none;
        border-color: var(--color-accent);
        box-shadow: 0 0 0 2px rgba(0, 255, 204, 0.2);
    }

    .modal-summary-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        font-size: 14px;
    }

    .modal-sum-val {
        font-size: 18px;
        color: var(--color-accent);
    }

    .btn-submit-quick {
        margin-top: 6px;
        margin-bottom: 0;
    }

    .modal-success-screen {
        text-align: center;
        padding: 20px 0 10px;
    }

    .success-check-badge {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: rgba(0, 255, 204, 0.15);
        color: var(--color-accent);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .modal-success-screen h4 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .modal-success-screen p {
        font-size: 14px;
        color: var(--color-text-muted);
        line-height: 1.5;
        margin-bottom: 22px;
    }

    .modal-success-screen .order-id {
        color: var(--color-accent);
    }

    .modal-success-screen .btn {
        margin: 0 auto;
        max-width: 200px;
    }

    /* Адаптивність */
    @media (max-width: 992px) {
        .cart-layout {
            flex-direction: column;
        }

        .cart-summary {
            width: 100%;
            position: static;
        }
    }

    @media (max-width: 768px) {
        .cross-sell-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .cart-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .cart-item {
            flex-wrap: wrap;
            position: relative;
            padding: 16px;
        }

        .item-info {
            min-width: calc(100% - 120px);
        }

        .item-remove {
            position: absolute;
            top: 14px;
            right: 14px;
        }

        .item-quantity {
            margin-top: 10px;
        }

        .item-price {
            flex: 1;
            text-align: right;
            margin-top: 10px;
        }
    }
</style>

<script>
    // Інтерактивна логіка кошика
    document.addEventListener("DOMContentLoaded", () => {
        let appliedPromo = null; // { code: 'PCSTORE', percent: 5 }
        let extraWarranty = false; // +1499
        const WARRANTY_PRICE = 1499;
        const FREE_SHIPPING_THRESHOLD = 20000;

        const promoCodes = {
            PCSTORE: { percent: 5, name: "PCSTORE (Знижка 5%)" },
            SUPERPC: { percent: 10, name: "SUPERPC (Знижка 10%)" },
            SALE5: { percent: 5, name: "SALE5 (Знижка 5%)" }
        };

        const formatPrice = (num) => {
            return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " ₴";
        };

        const updateCart = () => {
            const items = document.querySelectorAll("#cart-items-container .cart-item");
            const headerBadge = document.getElementById("header-items-badge");
            const summaryItemsLabel = document.getElementById("summary-items-label");
            const summaryItemsSum = document.getElementById("summary-items-sum");
            const summaryDiscountVal = document.getElementById("summary-discount-val");
            const summaryTotal = document.getElementById("summary-total-price");
            const modalTotal = document.getElementById("modal-sum-val");
            const cartLayout = document.getElementById("cart-layout");
            const cartEmpty = document.getElementById("cart-empty-state");
            const freeShippingBanner = document.getElementById("free-shipping-banner");
            const progressBar = document.getElementById("shipping-progress-bar");
            const bannerTitle = document.getElementById("shipping-banner-title");
            const bannerDesc = document.getElementById("shipping-banner-desc");
            const clearBtn = document.getElementById("btn-clear-cart");

            if (items.length === 0) {
                if (cartLayout) cartLayout.style.display = "none";
                if (freeShippingBanner) freeShippingBanner.style.display = "none";
                if (clearBtn) clearBtn.style.display = "none";
                if (cartEmpty) cartEmpty.style.display = "block";
                if (headerBadge) headerBadge.textContent = "0";
                return;
            }

            if (cartLayout) cartLayout.style.display = "flex";
            if (clearBtn) clearBtn.style.display = "inline-flex";
            if (cartEmpty) cartEmpty.style.display = "none";

            let totalQty = 0;
            let subtotal = 0;

            items.forEach((item) => {
                const singlePrice = parseInt(item.dataset.price || "0", 10);
                const qtyInput = item.querySelector(".qty-input");
                const qty = parseInt(qtyInput ? qtyInput.value : "1", 10);
                const itemTotal = singlePrice * qty;

                totalQty += qty;
                subtotal += itemTotal;

                const priceEl = item.querySelector(".item-price");
                if (priceEl) {
                    priceEl.textContent = formatPrice(itemTotal);
                }
            });

            // Підпис кількості товарів
            if (headerBadge) headerBadge.textContent = totalQty.toString();
            if (summaryItemsLabel) {
                let word = "товарів";
                const last = totalQty % 10;
                const lastTwo = totalQty % 100;
                if (last === 1 && lastTwo !== 11) word = "товар";
                else if (last >= 2 && last <= 4 && (lastTwo < 10 || lastTwo >= 20)) word = "товари";
                summaryItemsLabel.textContent = `${totalQty} ${word} на суму`;
            }

            if (summaryItemsSum) summaryItemsSum.textContent = formatPrice(subtotal);

            // Промокод
            let discountAmount = 0;
            if (appliedPromo) {
                discountAmount = Math.round((subtotal * appliedPromo.percent) / 100);
            }

            if (summaryDiscountVal) {
                if (discountAmount > 0) {
                    summaryDiscountVal.textContent = `- ${formatPrice(discountAmount)}`;
                    summaryDiscountVal.classList.add("has-discount");
                } else {
                    summaryDiscountVal.textContent = "0 ₴";
                    summaryDiscountVal.classList.remove("has-discount");
                }
            }

            // Додаткова гарантія
            let servicesSum = extraWarranty ? WARRANTY_PRICE : 0;

            // Загальна сума
            const grandTotal = Math.max(0, subtotal - discountAmount + servicesSum);
            if (summaryTotal) summaryTotal.textContent = formatPrice(grandTotal);
            if (modalTotal) modalTotal.textContent = formatPrice(grandTotal);

            // Прогрес безкоштовної доставки
            if (freeShippingBanner && progressBar && bannerTitle && bannerDesc) {
                freeShippingBanner.style.display = "flex";
                if (subtotal >= FREE_SHIPPING_THRESHOLD) {
                    progressBar.style.width = "100%";
                    bannerTitle.textContent = "Вам доступна безкоштовна доставка! 🎉";
                    bannerDesc.textContent = "Замовлення від 20 000 ₴ доставляються безкоштовно у відділення Нової Пошти";
                } else {
                    const diff = FREE_SHIPPING_THRESHOLD - subtotal;
                    const percent = Math.min(100, Math.round((subtotal / FREE_SHIPPING_THRESHOLD) * 100));
                    progressBar.style.width = `${percent}%`;
                    bannerTitle.textContent = `Додайте товарів ще на ${formatPrice(diff)} для безкоштовної доставки 🚚`;
                    bannerDesc.textContent = `Безкоштовна доставка активується автоматично при замовленні від 20 000 ₴`;
                }
            }
        };

        // Кількість + та -
        document.addEventListener("click", (e) => {
            const plusBtn = e.target.closest(".qty-btn.plus");
            const minusBtn = e.target.closest(".qty-btn.minus");
            const removeBtn = e.target.closest(".item-remove");

            if (plusBtn) {
                const item = plusBtn.closest(".cart-item");
                const input = item.querySelector(".qty-input");
                let val = parseInt(input.value || "1", 10);
                input.value = (val + 1).toString();
                updateCart();
            }

            if (minusBtn) {
                const item = minusBtn.closest(".cart-item");
                const input = item.querySelector(".qty-input");
                let val = parseInt(input.value || "1", 10);
                if (val > 1) {
                    input.value = (val - 1).toString();
                    updateCart();
                }
            }

            if (removeBtn) {
                const item = removeBtn.closest(".cart-item");
                const crossId = item.dataset.crossId;
                if (crossId) {
                    const addBtn = document.querySelector(`.btn-cross-add[data-id="${crossId}"]`);
                    if (addBtn) {
                        addBtn.classList.remove("added");
                        addBtn.textContent = "+ Додати";
                    }
                }
                item.classList.add("removing");
                setTimeout(() => {
                    item.remove();
                    updateCart();
                }, 250);
            }
        });

        // Очистити кошик
        const clearBtn = document.getElementById("btn-clear-cart");
        if (clearBtn) {
            clearBtn.addEventListener("click", () => {
                if (confirm("Ви дійсно бажаєте видалити всі товари з кошика?")) {
                    const items = document.querySelectorAll("#cart-items-container .cart-item");
                    items.forEach((it) => it.remove());

                    const crossBtns = document.querySelectorAll(".btn-cross-add.added");
                    crossBtns.forEach((b) => {
                        b.classList.remove("added");
                        b.textContent = "+ Додати";
                    });

                    updateCart();
                }
            });
        }

        // Accordion для промокоду
        const promoAccordion = document.getElementById("promo-accordion");
        const promoToggle = document.getElementById("promo-toggle");
        if (promoToggle && promoAccordion) {
            promoToggle.addEventListener("click", () => {
                const isOpen = promoAccordion.classList.toggle("open");
                promoToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                if (isOpen) {
                    const input = document.getElementById("promo-input");
                    if (input) setTimeout(() => input.focus(), 150);
                }
            });
        }

        // Застосування промокоду
        const applyPromoBtn = document.getElementById("btn-apply-promo");
        const promoInput = document.getElementById("promo-input");
        const promoFeedback = document.getElementById("promo-feedback");
        const promoActiveChip = document.getElementById("promo-active-chip");
        const chipName = document.getElementById("chip-name");
        const chipSave = document.getElementById("chip-save");
        const removePromoBtn = document.getElementById("btn-remove-promo");
        const sampleCodeBtn = document.getElementById("code-chip");

        const applyPromo = (codeStr) => {
            const cleanCode = (codeStr || "").trim().toUpperCase();
            if (!cleanCode) {
                if (promoFeedback) {
                    promoFeedback.textContent = "Будь ласка, введіть код";
                    promoFeedback.className = "promo-feedback error";
                }
                return;
            }

            if (promoCodes[cleanCode]) {
                appliedPromo = { code: cleanCode, ...promoCodes[cleanCode] };
                if (promoFeedback) {
                    promoFeedback.textContent = `✓ Промокод ${cleanCode} успішно застосовано!`;
                    promoFeedback.className = "promo-feedback success";
                }
                if (promoActiveChip) promoActiveChip.style.display = "flex";
                if (chipName) chipName.textContent = cleanCode;
                if (chipSave) chipSave.textContent = `-${appliedPromo.percent}%`;
                if (promoInput) promoInput.value = "";
                updateCart();
            } else {
                if (promoFeedback) {
                    promoFeedback.textContent = "✕ Недійсний або застарілий промокод";
                    promoFeedback.className = "promo-feedback error";
                }
            }
        };

        if (applyPromoBtn && promoInput) {
            applyPromoBtn.addEventListener("click", () => {
                applyPromo(promoInput.value);
            });
            promoInput.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    applyPromo(promoInput.value);
                }
            });
        }

        if (sampleCodeBtn && promoInput) {
            sampleCodeBtn.addEventListener("click", () => {
                promoInput.value = "PCSTORE";
                applyPromo("PCSTORE");
            });
        }

        if (removePromoBtn) {
            removePromoBtn.addEventListener("click", () => {
                appliedPromo = null;
                if (promoActiveChip) promoActiveChip.style.display = "none";
                if (promoFeedback) {
                    promoFeedback.textContent = "Промокод скасовано";
                    promoFeedback.className = "promo-feedback";
                }
                updateCart();
            });
        }

        // Додаткова гарантія
        const warrantyCheckbox = document.getElementById("addon-warranty");
        if (warrantyCheckbox) {
            warrantyCheckbox.addEventListener("change", (e) => {
                extraWarranty = e.target.checked;
                updateCart();
            });
        }

        // Додавання супутніх товарів (Cross-sell) через Template
        document.querySelectorAll(".btn-cross-add").forEach((btn) => {
            btn.addEventListener("click", () => {
                if (btn.classList.contains("added")) return;

                const name = btn.dataset.name;
                const price = btn.dataset.price;
                const code = btn.dataset.code;
                const img = btn.dataset.img;
                const id = btn.dataset.id;

                const container = document.getElementById("cart-items-container");
                const template = document.getElementById("cart-item-template");
                if (container && template) {
                    const clone = template.content.cloneNode(true);
                    const itemEl = clone.querySelector(".cart-item");
                    itemEl.dataset.id = id;
                    itemEl.dataset.price = price;
                    itemEl.dataset.crossId = id;

                    const imgEl = itemEl.querySelector(".item-img");
                    if (imgEl) {
                        imgEl.src = img;
                        imgEl.alt = name;
                    }

                    const titleEl = itemEl.querySelector(".item-title");
                    if (titleEl) {
                        titleEl.textContent = name;
                    }

                    const codeEl = itemEl.querySelector(".item-code");
                    if (codeEl) {
                        codeEl.textContent = `Код: ${code}`;
                    }

                    const priceEl = itemEl.querySelector(".item-price");
                    if (priceEl) {
                        priceEl.dataset.singlePrice = price;
                        priceEl.textContent = formatPrice(parseInt(price, 10));
                    }

                    container.appendChild(clone);

                    btn.classList.add("added");
                    btn.textContent = "✓ У кошику";
                    updateCart();
                }
            });
        });

        // Модалка швидкого замовлення
        const quickModal = document.getElementById("quick-order-modal");
        const openQuickBtn = document.getElementById("btn-quick-order");
        const closeQuickBtn = document.getElementById("modal-close-btn");
        const quickForm = document.getElementById("quick-order-form");
        const successScreen = document.getElementById("modal-success-screen");
        const doneBtn = document.getElementById("modal-done-btn");

        if (openQuickBtn && quickModal) {
            openQuickBtn.addEventListener("click", () => {
                quickModal.style.display = "flex";
                if (quickForm) quickForm.style.display = "flex";
                if (successScreen) successScreen.style.display = "none";
                const phoneInput = document.getElementById("quick-phone");
                if (phoneInput) setTimeout(() => phoneInput.focus(), 100);
            });
        }

        const closeModal = () => {
            if (quickModal) quickModal.style.display = "none";
        };

        if (closeQuickBtn) closeQuickBtn.addEventListener("click", closeModal);
        if (doneBtn) doneBtn.addEventListener("click", closeModal);
        if (quickModal) {
            quickModal.addEventListener("click", (e) => {
                if (e.target === quickModal) closeModal();
            });
        }

        if (quickForm) {
            quickForm.addEventListener("submit", (e) => {
                e.preventDefault();
                quickForm.style.display = "none";
                if (successScreen) successScreen.style.display = "block";
            });
        }

        // Кнопка основного оформлення
        const checkoutBtn = document.getElementById("btn-checkout");
        if (checkoutBtn) {
            checkoutBtn.addEventListener("click", () => {
                alert("Перехід до оформлення замовлення (вибір адреси та способу оплати)");
            });
        }

        // Початкова ініціалізація
        updateCart();
    });
</script>
