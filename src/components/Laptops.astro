type LaptopFilterField =
  | "brand"
  | "gpuChipset"
  | "cpuModel"
  | "screenSize"
  | "formFactor"
  | "storageVolume"
  | "vramVolume"
  | "ramType"
  | "cpuCores";

const countBy = (key: LaptopFilterField, val: string) =>
  laptopsList.filter((item) => item[key] === val).length;
---

<section class="prebuild-container container">
    <div class="breadcrumb">
        <a href="/catalog">Каталог</a> / 
        <span>Ноутбуки</span>
    </div>

    <div class="catalog-page-header">
        <h1 class="page-title">Ноутбуки</h1>
        <p class="page-subtitle">Ігрові, бізнес-моделі та ультрабуки з актуальними процесорами та відеокартами</p>
    </div>

    <div class="shop-layout">
        <aside class="filters-sidebar">
            <h3>Фільтри</h3>

            <!-- 1. Виробник -->
            <div class="filter-box">
                <span class="filter-title">Виробник</span>
                <div class="filter-options">
                    {brandOptions.map((opt) => (
                        <label class="filter-option-row">
                            <span class="option-left">
                                <input type="checkbox" class="filter-checkbox" data-group="brand" value={opt.value} />
                                <span>{opt.label}</span>
                            </span>
                            <span class="option-count">{countBy("brand", opt.value)}</span>
                        </label>
                    ))}
                </div>
            </div>

            <!-- 2. Графічний чіпсет -->
            <div class="filter-box">
                <span class="filter-title">Графічний чіпсет</span>
                <div class="filter-options" data-expandable-list="gpu">
                    {gpuOptions.map((opt, idx) => {
                        const isHiddenInitially = idx >= 10;
                        return (
                            <label class:list={["filter-option-row", { "extra-option hidden-option": isHiddenInitially }]}>
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" data-group="gpu" value={opt.value} />
                                    <span>{opt.label}</span>
                                </span>
                                <span class="option-count">{countBy("gpuChipset", opt.value)}</span>
                            </label>
                        );
                    })}
                </div>
                {gpuOptions.length > 10 && (
                    <button
                        type="button"
                        class="btn-show-more"
                        data-target="gpu"
                        data-more-text={`Показати ще ${gpuOptions.length - 10}`}
                        data-less-text="Згорнути"
                    >
                        Показати ще {gpuOptions.length - 10} ⌄
                    </button>
                )}
            </div>

            <!-- 3. Модель процесора -->
            <div class="filter-box">
                <span class="filter-title">Модель процесора</span>
                <div class="filter-options" data-expandable-list="cpu">
                    {cpuOptions.map((opt, idx) => {
                        const isHiddenInitially = idx >= 9;
                        return (
                            <label class:list={["filter-option-row", { "extra-option hidden-option": isHiddenInitially }]}>
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" data-group="cpu" value={opt.value} />
                                    <span>{opt.label}</span>
                                </span>
                                <span class="option-count">{countBy("cpuModel", opt.value)}</span>
                            </label>
                        );
                    })}
                </div>
                {cpuOptions.length > 9 && (
                    <button
                        type="button"
                        class="btn-show-more"
                        data-target="cpu"
                        data-more-text={`Показати ще ${cpuOptions.length - 9}`}
                        data-less-text="Згорнути"
                    >
                        Показати ще {cpuOptions.length - 9} ⌄
                    </button>
                )}
            </div>

            <!-- 4. Діагональ екрана -->
            <div class="filter-box">
                <span class="filter-title">Діагональ екрана</span>
                <div class="filter-options">
                    {screenSizeOptions.map((opt) => (
                        <label class="filter-option-row">
                            <span class="option-left">
                                <input type="checkbox" class="filter-checkbox" data-group="screenSize" value={opt.value} />
                                <span>{opt.label}</span>
                            </span>
                            <span class="option-count">{countBy("screenSize", opt.value)}</span>
                        </label>
                    ))}
                </div>
            </div>

            <!-- 5. Призначення / Тип -->
            <div class="filter-box">
                <span class="filter-title">Призначення / Тип</span>
                <div class="filter-options">
                    {formFactorOptions.map((opt) => (
                        <label class="filter-option-row">
                            <span class="option-left">
                                <input type="checkbox" class="filter-checkbox" data-group="formFactor" value={opt.value} />
                                <span>{opt.label}</span>
                            </span>
                            <span class="option-count">{countBy("formFactor", opt.value)}</span>
                        </label>
                    ))}
                </div>
            </div>

            <!-- 6. Об'єм накопичувача (SSD) -->
            <div class="filter-box">
                <span class="filter-title">Об'єм накопичувача</span>
                <div class="filter-options" data-expandable-list="storageVolume">
                    {storageVolumeOptions.map((opt, idx) => {
                        const isHiddenInitially = idx >= 6;
                        return (
                            <label class:list={["filter-option-row", { "extra-option hidden-option": isHiddenInitially }]}>
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" data-group="storageVolume" value={opt.value} />
                                    <span>{opt.label}</span>
                                </span>
                                <span class="option-count">{countBy("storageVolume", opt.value)}</span>
                            </label>
                        );
                    })}
                </div>
                {storageVolumeOptions.length > 6 && (
                    <button
                        type="button"
                        class="btn-show-more"
                        data-target="storageVolume"
                        data-more-text={`Показати ще ${storageVolumeOptions.length - 6}`}
                        data-less-text="Згорнути"
                    >
                        Показати ще {storageVolumeOptions.length - 6} ⌄
                    </button>
                )}
            </div>

            <!-- 7. Об'єм відеопам'яті -->
            <div class="filter-box">
                <span class="filter-title">Об'єм відеопам'яті</span>
                <div class="filter-options" data-expandable-list="vramVolume">
                    {vramVolumeOptions.map((opt, idx) => {
                        const isHiddenInitially = idx >= 10;
                        return (
                            <label class:list={["filter-option-row", { "extra-option hidden-option": isHiddenInitially }]}>
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" data-group="vramVolume" value={opt.value} />
                                    <span>{opt.label}</span>
                                </span>
                                <span class="option-count">{countBy("vramVolume", opt.value)}</span>
                            </label>
                        );
                    })}
                </div>
                {vramVolumeOptions.length > 10 && (
                    <button
                        type="button"
                        class="btn-show-more"
                        data-target="vramVolume"
                        data-more-text={`Показати ще ${vramVolumeOptions.length - 10}`}
                        data-less-text="Згорнути"
                    >
                        Показати ще {vramVolumeOptions.length - 10} ⌄
                    </button>
                )}
            </div>

            <!-- 8. Тип оперативної пам'яті -->
            <div class="filter-box">
                <span class="filter-title">Тип оперативної пам'яті</span>
                <div class="filter-options">
                    {ramTypeOptions.map((opt) => (
                        <label class="filter-option-row">
                            <span class="option-left">
                                <input type="checkbox" class="filter-checkbox" data-group="ramType" value={opt.value} />
                                <span>{opt.label}</span>
                            </span>
                            <span class="option-count">{countBy("ramType", opt.value)}</span>
                        </label>
                    ))}
                </div>
            </div>

            <!-- 9. Кількість ядер процесора -->
            <div class="filter-box">
                <span class="filter-title">Кількість ядер процесора</span>
                <div class="filter-options">
                    {cpuCoresOptions.map((opt) => (
                        <label class="filter-option-row">
                            <span class="option-left">
                                <input type="checkbox" class="filter-checkbox" data-group="cpuCores" value={opt.value} />
                                <span>{opt.label}</span>
                            </span>
                            <span class="option-count">{countBy("cpuCores", opt.value)}</span>
                        </label>
                    ))}
                </div>
            </div>

            <!-- 10. Ціна -->
            <div class="filter-box">
                <span class="filter-title">Ціна (₴)</span>
                <div class="price-inputs">
                    <input type="number" id="price-min" placeholder="Від" />
                    <input type="number" id="price-max" placeholder="До" />
                </div>
            </div>

            <button type="button" id="apply-filters" class="btn-apply">Застосувати фільтри</button>
            <button type="button" id="reset-filters" class="btn-reset">Скинути</button>

            <div class="filter-footer-bar">
                <button type="button" id="cancel-filters-btn" class="btn-cancel-subtle">Скасувати</button>
                <button type="button" id="select-filters-btn" class="btn-select-subtle">Виберіть фільтри</button>
            </div>
        </aside>

        <div class="products-area">
            <div class="products-grid-list" id="products-grid">
                {laptopsList.map((item) => {
                    const imgSrc = item.img || `/products_pics/${item.slug}-1.jpg`;
                    return (
                        <div
                            class="product-card-item"
                            data-brand={item.brand}
                            data-gpu={item.gpuChipset}
                            data-cpu={item.cpuModel}
                            data-screen-size={item.screenSize}
                            data-form-factor={item.formFactor}
                            data-storage-volume={item.storageVolume}
                            data-vram-volume={item.vramVolume}
                            data-ram-type={item.ramType}
                            data-cpu-cores={item.cpuCores}
                            data-price={item.priceNum}
                            data-slug={item.slug}
                        >
                            <div class="product-card-img">
                                <img
                                    src={imgSrc}
                                    alt={item.title}
                                    loading="lazy"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
                                />
                                <span class="img-fallback-text" style="display: none;">{item.imgText}</span>
                            </div>
                            <div class="product-card-info">
                                <h3>{item.title}</h3>
                                <ul class="mini-specs">
                                    {item.shortSpecs.map((s) => <li>{s}</li>)}
                                </ul>
                                <div class="price">{item.price}</div>
                                <button type="button" class="btn-detail">Дивитися ноутбук</button>
                            </div>
                        </div>
                    );
                })}
            </div>

            <div id="no-products-message" class="no-products" style="display: none;">
                <p>Наразі немає ноутбуків з обраними фільтрами.</p>
                <button type="button" id="empty-reset-btn" class="btn-detail" style="display:inline-block; margin-top:10px; width: auto; padding: 10px 20px;">
                    Скинути фільтри
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    const applyBtn = document.getElementById('apply-filters');
    const resetBtn = document.getElementById('reset-filters');
    const cancelBtn = document.getElementById('cancel-filters-btn');
    const selectFiltersBtn = document.getElementById('select-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const productCards = document.querySelectorAll('.product-card-item');
    const minInput = document.getElementById('price-min') as HTMLInputElement;
    const maxInput = document.getElementById('price-max') as HTMLInputElement;
    const noProductsMsg = document.getElementById('no-products-message');

    const filterGroups = [
        { group: 'brand', attr: 'data-brand' },
        { group: 'gpu', attr: 'data-gpu' },
        { group: 'cpu', attr: 'data-cpu' },
        { group: 'screenSize', attr: 'data-screen-size' },
        { group: 'formFactor', attr: 'data-form-factor' },
        { group: 'storageVolume', attr: 'data-storage-volume' },
        { group: 'vramVolume', attr: 'data-vram-volume' },
        { group: 'ramType', attr: 'data-ram-type' },
        { group: 'cpuCores', attr: 'data-cpu-cores' }
    ];

    function getCheckedByGroup(group: string): string[] {
        return Array.from(
            document.querySelectorAll(`.filter-checkbox[data-group="${group}"]:checked`)
        ).map((el) => (el as HTMLInputElement).value);
    }

    function filterLaptops() {
        const activeSelections = filterGroups.map((fg) => ({
            attr: fg.attr,
            values: getCheckedByGroup(fg.group)
        }));

        const minPrice = minInput?.value ? parseFloat(minInput.value) : 0;
        const maxPrice = maxInput?.value ? parseFloat(maxInput.value) : Infinity;

        let visibleCount = 0;

        productCards.forEach((card) => {
            const matchesGroups = activeSelections.every((sel) => {
                if (sel.values.length === 0) return true;
                const cardVal = card.getAttribute(sel.attr) || '';
                return sel.values.includes(cardVal);
            });

            const price = parseFloat(card.getAttribute('data-price') || '0');
            const matchesPrice = price >= minPrice && price <= maxPrice;

            if (matchesGroups && matchesPrice) {
                (card as HTMLElement).style.display = 'flex';
                visibleCount++;
            } else {
                (card as HTMLElement).style.display = 'none';
            }
        });

        if (noProductsMsg) {
            noProductsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }

    document.querySelectorAll('.btn-show-more').forEach((btn) => {
        btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-target');
            const list = document.querySelector(`[data-expandable-list="${target}"]`);
            if (!list) return;

            const isExpanded = btn.getAttribute('data-expanded') === 'true';
            const extraItems = list.querySelectorAll('.extra-option');

            extraItems.forEach((item) => {
                item.classList.toggle('hidden-option', isExpanded);
            });

            btn.setAttribute('data-expanded', String(!isExpanded));
            const moreText = btn.getAttribute('data-more-text') || 'Показати ще';
            const lessText = btn.getAttribute('data-less-text') || 'Згорнути';
            btn.textContent = !isExpanded ? `${lessText} ⌃` : `${moreText} ⌄`;
        });
    });

    window.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        filterGroups.forEach(({ group }) => {
            const paramVal = params.get(group);
            if (paramVal) {
                paramVal.split(',').forEach((val) => {
                    const cb = document.querySelector(
                        `.filter-checkbox[data-group="${group}"][value="${val}"]`
                    ) as HTMLInputElement | null;
                    if (cb) {
                        cb.checked = true;
                        const parentRow = cb.closest('.extra-option');
                        if (parentRow && parentRow.classList.contains('hidden-option')) {
                            parentRow.classList.remove('hidden-option');
                        }
                    }
                });
            }
        });

        filterLaptops();
    });

    productCards.forEach((card) => {
        card.addEventListener('click', () => {
            const slug = card.getAttribute('data-slug');
            if (slug) {
                window.location.href = `/catalog/product/${slug}`;
            }
        });
    });

    applyBtn?.addEventListener('click', filterLaptops);

    function resetAllFilters() {
        document.querySelectorAll('.filter-checkbox').forEach((cb) => {
            (cb as HTMLInputElement).checked = false;
        });
        if (minInput) minInput.value = '';
        if (maxInput) maxInput.value = '';
        window.history.replaceState({}, '', window.location.pathname);
        filterLaptops();
    }

    resetBtn?.addEventListener('click', resetAllFilters);
    cancelBtn?.addEventListener('click', resetAllFilters);
    emptyResetBtn?.addEventListener('click', resetAllFilters);

    selectFiltersBtn?.addEventListener('click', () => {
        const firstCheckbox = document.querySelector('.filter-checkbox') as HTMLInputElement | null;
        firstCheckbox?.focus();
        firstCheckbox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
</script>

