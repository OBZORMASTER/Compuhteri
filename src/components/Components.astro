---

<section class="components-container">
    <div class="page-header">
        <h1 class="page-title">Комплектуючі до ПК</h1>
        <p class="page-subtitle">Оберіть необхідну категорію деталей для вашого комп'ютера</p>
    </div>

    <div class="components-grid">
        {componentCategories.map((cat) => (
            <div class="comp-category-card">
                <div class="card-content-top">
                    <!-- Заглушка під майбутню картинку -->
                    <div class="image-placeholder">
                        <!-- <img src="/images/categories/example.png" alt={cat.title} class="category-real-img" /> -->
                        <span class="placeholder-text">Фото</span>
                    </div>

                    <div class="card-titles">
                        <h3>{cat.title}</h3>
                        <p>{cat.desc}</p>
                    </div>

                    <div class="tags-list">
                        {cat.tags.map((tag) => (
                            <a href={tag.href} class="tag-pill">{tag.name}</a>
                        ))}
                    </div>
                </div>

                <div class="card-bottom">
                    <a href={cat.allLink.href} class="all-link">{cat.allLink.text} <span>›</span></a>
                </div>

                <!-- Головне посилання розтягнуте на всю картку поверх всього -->
                <a href={cat.allLink.href} class="card-link-overlay" aria-label={cat.title}></a>
            </div>
        ))}
    </div>
</section>

<style>
    .components-container {
        max-width: 1200px;
        margin: 40px auto 80px;
        padding: 0 24px;
    }

    .page-header {
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 32px;
        margin: 0 0 8px;
        color: var(--color-text-main);
        font-weight: 700;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 16px;
        margin: 0;
    }

    .components-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        align-items: stretch;
    }

    .comp-category-card {
        position: relative; /* Необхідно для позиціонування розтягнутого посилання */
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.2s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .comp-category-card:hover {
        border-color: var(--color-accent);
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(0, 255, 204, 0.1);
    }

    /* Розтягуємо посилання на всю картку поверх усього за допомогою псевдоелемента або абсолютної позиції */
    .card-link-overlay {
        position: absolute;
        inset: 0;
        z-index: 1; /* Робимо клікабельним поверх фону, але нижче за теги */
        border-radius: 16px;
    }

    .card-content-top {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .image-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background-color: var(--color-element);
        border: 1px dashed var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .placeholder-text {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .category-real-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
    }

    .card-titles h3 {
        margin: 0 0 4px;
        font-size: 18px;
        color: var(--color-text-main);
        font-weight: 600;
    }

    .card-titles p {
        margin: 0;
        font-size: 13px;
        color: var(--color-text-muted);
        line-height: 1.4;
    }

    .tags-list {
        position: relative;
        z-index: 2; /* Теги повинні бути вище за оверлей, щоб на них можна було натискати окремо */
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 4px;
    }

    .tag-pill {
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-muted);
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .tag-pill:hover {
        background-color: rgba(0, 255, 204, 0.1);
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .card-bottom {
        position: relative;
        z-index: 2; /* Кнопка «Усі...» теж повинна бути вище */
        border-top: 1px solid var(--color-border);
        padding-top: 16px;
        margin-top: 20px;
    }

    .all-link {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: transform 0.15s;
    }

    .all-link:hover {
        transform: translateX(3px);
    }

    @media (max-width: 992px) {
        .components-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .components-grid {
            grid-template-columns: 1fr;
        }
    }
</style>