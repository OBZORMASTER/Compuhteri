---

<section class="catalog-container">
    <div class="catalog-header">
        <h1 class="page-title">Каталог товарів</h1>
        <p class="page-subtitle">Оберіть категорію, щоб переглянути доступні комплектуючі, готові ПК та периферію</p>
    </div>

    <div class="catalog-board">
        <!-- Ліва колонка: основні категорії -->
        <aside class="catalog-sidebar">
            <ul class="category-nav">
                {catalogCategories.map((cat, index) => (
                    <li>
                        <a
                            href={cat.link}
                            class={`cat-link-item ${index === 0 ? 'active' : ''}`}
                            data-target={cat.id}
                        >
                            <div class="cat-btn-left">
                                <span class="cat-icon-box">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        set:html={cat.icon}
                                    />
                                </span>
                                <span class="cat-title">{cat.title}</span>
                            </div>
                            <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </a>
                    </li>
                ))}
            </ul>
        </aside>

        <!-- Права частина: підкатегорії обраного розділу -->
        <div class="catalog-content">
            {catalogCategories.map((cat, index) => (
                <div class={`subcat-panel ${index === 0 ? 'active' : ''}`} id={`panel-${cat.id}`}>
                    <div class="panel-top">
                        <h2>{cat.title}</h2>
                        <a href={cat.link} class="btn-go-category">Перейти до розділу →</a>
                    </div>

                    <div class="subcat-columns">
                        {cat.columns.map((col) => (
                            <div class="subcat-group">
                                <h3 class="group-heading">
                                    <span class="group-dot"></span>
                                    {col.heading}
                                </h3>
                                <ul class="group-list">
                                    {col.items.map((item) => (
                                        <li>
                                            <a href={item.href}>{item.name}</a>
                                        </li>
                                    ))}
                                </ul>
                                {col.allLink && (
                                    <a href={col.allLink.href} class="group-all-link">
                                        {col.allLink.text} <span>›</span>
                                    </a>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .catalog-container {
        max-width: 1200px;
        margin: 40px auto 80px;
        padding: 0 24px;
    }

    .catalog-header {
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 32px;
        margin: 0 0 8px;
        color: var(--color-text-main);
        font-weight: 700;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 16px;
        margin: 0;
    }

    .catalog-board {
        display: flex;
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        min-height: 540px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .catalog-sidebar {
        width: 310px;
        flex-shrink: 0;
        background-color: var(--color-surface);
        border-right: 1px solid var(--color-border);
        padding: 16px 12px;
    }

    .category-nav {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cat-link-item {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 10px;
        color: var(--color-text-main);
        font-family: inherit;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        text-decoration: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .cat-btn-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cat-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background-color: var(--color-element);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .arrow-icon {
        color: var(--color-text-muted);
        opacity: 0.6;
        transition: transform 0.2s, color 0.2s;
        flex-shrink: 0;
    }

    .cat-link-item:hover {
        background-color: rgba(255, 255, 255, 0.03);
        border-color: var(--color-border);
    }

    .cat-link-item.active {
        background-color: rgba(0, 255, 204, 0.08);
        border-color: var(--color-accent);
        color: var(--color-accent);
        font-weight: 600;
    }

    .cat-link-item.active .cat-icon-box {
        background-color: rgba(0, 255, 204, 0.15);
        color: var(--color-accent);
    }

    .cat-link-item.active .arrow-icon {
        color: var(--color-accent);
        opacity: 1;
        transform: translateX(3px);
    }

    .catalog-content {
        flex: 1;
        padding: 32px 36px;
    }

    .subcat-panel {
        display: none;
        animation: fadeIn 0.2s ease;
    }

    .subcat-panel.active {
        display: block;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .panel-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
        margin-bottom: 28px;
        border-bottom: 1px solid var(--color-border);
    }

    .panel-top h2 {
        margin: 0;
        font-size: 24px;
        color: var(--color-text-main);
    }

    .btn-go-category {
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-main);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-go-category:hover {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: #000;
    }

    .subcat-columns {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px 28px;
    }

    .group-heading {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text-main);
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .group-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background-color: var(--color-accent);
        box-shadow: 0 0 8px var(--color-accent);
        flex-shrink: 0;
    }

    .group-list {
        list-style: none;
        padding: 0 0 0 18px;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .group-list a {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 14px;
        transition: color 0.15s, transform 0.15s;
        display: inline-block;
    }

    .group-list a:hover {
        color: var(--color-accent);
        transform: translateX(3px);
    }

    .group-all-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding-left: 18px;
        font-size: 14px;
        font-weight: 700;
        color: var(--color-text-main);
        text-decoration: none;
        transition: color 0.2s;
    }

    .group-all-link:hover {
        color: var(--color-accent);
    }

    @media (max-width: 992px) {
        .catalog-board {
            flex-direction: column;
        }
        .catalog-sidebar {
            width: 100%;
            border-right: none;
            border-bottom: 1px solid var(--color-border);
        }
        .category-nav {
            flex-direction: row;
            flex-wrap: wrap;
        }
        .category-nav li {
            flex: 1 1 calc(50% - 6px);
        }
        .subcat-columns {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .category-nav li {
            flex: 1 1 100%;
        }
        .catalog-content {
            padding: 24px 20px;
        }
        .panel-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
        .subcat-columns {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const links = document.querySelectorAll('.cat-link-item');
    const panels = document.querySelectorAll('.subcat-panel');

    function activateCategory(targetId: string | null) {
        if (!targetId) return;

        links.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('data-target') === targetId);
        });

        panels.forEach((panel) => {
            panel.classList.toggle('active', panel.id === `panel-${targetId}`);
        });
    }

    links.forEach((link) => {
        link.addEventListener('mouseenter', () => {
            activateCategory(link.getAttribute('data-target'));
        });
    });
</script>