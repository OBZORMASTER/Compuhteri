<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .section-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 30px;
        text-align: center;
    }

    .accent-text {
        color: var(--color-accent);
    }

    .hero-section {
        background-color: var(--color-surface);
        padding: 80px 0;
        border-bottom: 1px solid var(--color-border);
    }

    .hero-content {
        display: flex;
        align-items: center;
        gap: 100px;
        justify-content: space-between;
    }

    .hero-text {
        flex: 1;
    }

    .badge {
        display: inline-block;
        padding: 6px 12px;
        background-color: rgba(0, 255, 204, 0.1);
        color: var(--color-accent);
        border: 1px solid var(--color-accent);
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .hero-text h1 {
        font-size: 48px;
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .hero-text p {
        color: var(--color-text-muted);
        font-size: 18px;
        margin-bottom: 30px;
        max-width: 500px;
    }

    .hero-buttons {
        display: flex;
        gap: 16px;
    }

    .btn {
        padding: 14px 28px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }

    .btn-primary {
        background-color: var(--color-accent);
        color: #000;
        border: none;
    }

    .btn-primary:hover {
        background-color: var(--color-accent-hover);
        transform: translateY(-2px);
    }

    .btn-outline {
        background-color: transparent;
        color: var(--color-text-main);
        border: 1px solid var(--color-border);
    }

    .btn-outline:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .hero-image {
        flex: 1;
        display: flex;
        justify-content: flex-end;
    }

    .pc-slider {
        width: 100%;
        max-width: 550px;
        height: 380px;
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--color-border);
        box-shadow: 0 15px 45px rgba(0, 255, 204, 0.15);
    }

    .slider-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

    .slider-img.active {
        opacity: 1;
    }

    .categories-section {
        padding: 80px 24px;
    }

    .categories-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .category-card {
        flex: 1 1 calc(33.333% - 20px);
        min-width: 220px;
        max-width: 350px;
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 30px 20px;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
    }

    .category-card:hover {
        border-color: var(--color-accent);
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 255, 204, 0.1);
    }

    .category-icon {
        width: 64px;
        height: 64px;
        color: var(--color-text-main);
        transition:
            transform 0.3s ease,
            color 0.3s ease;
    }

    .category-card:hover .category-icon {
        transform: scale(1.15) translateY(-5px);
        color: var(--color-accent);
    }

    .category-card h3 {
        font-size: 18px;
        margin: 0;
        font-weight: 600;
        color: var(--color-text-main);
        transition: color 0.3s ease;
    }

    .category-card:hover h3 {
        color: var(--color-accent);
    }

    .steps-section {
        background-color: var(--color-surface);
        padding: 60px 0;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .steps-grid {
        display: flex;
        justify-content: space-between;
        gap: 30px;
    }

    .step-card {
        flex: 1;
        text-align: center;
    }

    .step-number {
        font-size: 48px;
        font-weight: 800;
        color: var(--color-border);
        margin-bottom: 10px;
    }

    .step-card h3 {
        font-size: 20px;
        margin-bottom: 10px;
        color: var(--color-accent);
    }

    .step-card p {
        color: var(--color-text-muted);
        font-size: 15px;
    }

    .bestsellers-section {
        padding: 80px 24px 100px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
    }

    .section-header .section-title {
        margin-bottom: 0;
    }

    .view-all {
        color: var(--color-text-muted);
        font-weight: 600;
        transition: color 0.2s;
    }

    .view-all:hover {
        color: var(--color-accent);
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .product-card {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s;
    }

    .product-card:hover {
        border-color: var(--color-text-muted);
        transform: translateY(-5px);
    }

    .product-info {
        padding: 20px;
    }

    .product-title {
        font-size: 16px;
        line-height: 1.4;
        margin-bottom: 20px;
        min-height: 44px;
    }

    .product-img {
        width: 100%;
        height: 220px;
        object-fit: contain;
        padding: 14px;
        box-sizing: border-box;
        background-color: var(--color-surface);
        display: block;
        border-bottom: 1px solid var(--color-border);
        transition: transform 0.4s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.04);
    }

    .product-title-link {
        text-decoration: none;
        color: inherit;
    }

    .product-title-link:hover .product-title {
        color: var(--color-accent);
    }

    .product-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .price {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-accent);
    }

    .btn-cart {
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cart:hover {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: #000;
    }

    @media (max-width: 992px) {
        .hero-content {
            flex-direction: column;
            text-align: center;
        }
        .hero-buttons {
            justify-content: center;
        }
        .hero-text p {
            margin: 0 auto 30px;
        }
        .products-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .category-card {
            flex: 1 1 100%;
        }
        .steps-grid {
            flex-direction: column;
            gap: 40px;
        }
        .products-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const images = document.querySelectorAll(".slider-img");
        let currentIndex = 0;

        if (images.length > 0) {
            setInterval(() => {
                images[currentIndex].classList.remove("active");
                currentIndex = (currentIndex + 1) % images.length;
                images[currentIndex].classList.add("active");
            }, 4000);
        }

        document.querySelectorAll(".bestsellers-section .btn-cart").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();

                const card = btn.closest(".product-card") as HTMLElement | null;
                if (!card) return;

                const id = card.dataset.id || "";
                const title = card.dataset.title || "";
                const priceStr = card.dataset.price || "0 ₴";
                const priceNum = parseInt(priceStr.replace(/\D/g, ""), 10) || 0;
                const category = card.dataset.category || "";
                const imgUrl = card.dataset.img || "";

                if (!id || !title) return;

                const cart = JSON.parse(localStorage.getItem("pcstore_cart") || "[]");
                const existingIndex = cart.findIndex((item: any) => item.id === id);

                if (existingIndex > -1) {
                    cart[existingIndex].quantity += 1;
                } else {
                    cart.push({
                        id,
                        title,
                        price: priceStr,
                        priceNum,
                        category,
                        quantity: 1,
                        img: imgUrl,
                    });
                }

                localStorage.setItem("pcstore_cart", JSON.stringify(cart));

                const buttonEl = btn as HTMLElement;
                const prevBg = buttonEl.style.backgroundColor;
                const prevColor = buttonEl.style.color;
                buttonEl.style.backgroundColor = "#10B981";
                buttonEl.style.color = "#fff";

                window.setTimeout(() => {
                    buttonEl.style.backgroundColor = prevBg;
                    buttonEl.style.color = prevColor;
                }, 900);
            });
        });
    });
</script>