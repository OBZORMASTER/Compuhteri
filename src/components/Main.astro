<!-- ГОЛОВНИЙ БАНЕР -->
<section class="hero-section">
    <div class="container hero-content">
        <div class="hero-text">
            <span class="badge">Нове надходження</span>
            <h1>
                Створи ПК своєї мрії з <span class="accent-text">PC STORE</span>
            </h1>
            <p>
                Ігрові станції, потужні комплектуючі та професійна периферія.
                Збери ідеальний комп'ютер у нашому конфігураторі або обери
                готове рішення.
            </p>
            <div class="hero-buttons">
                <a href="/configurator" class="btn btn-primary">Зібрати ПК</a>
                <a href="/catalog" class="btn btn-outline">В каталог</a>
            </div>
        </div>
        <div class="hero-image">
            <div class="pc-slider">
                <img
                    src="https://images.unsplash.com/photo-1587202372634-32705e3bf49c?auto=format&fit=crop&q=80&w=600&h=400"
                    alt="Ігровий ПК 1"
                    class="slider-img active"
                />
                <img
                    src="https://images.unsplash.com/photo-1555680202-c86f0e12f086?auto=format&fit=crop&q=80&w=600&h=400"
                    alt="Ігровий ПК 2"
                    class="slider-img"
                />
                <img
                    src="https://images.unsplash.com/photo-1593640408182-31c70c8268f5?auto=format&fit=crop&q=80&w=600&h=400"
                    alt="Геймерський сетап 3"
                    class="slider-img"
                />
                <img
                    src="https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?auto=format&fit=crop&q=80&w=600&h=400"
                    alt="Комплектуючі 4"
                    class="slider-img"
                />
                <img
                    src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=600&h=400"
                    alt="Геймерська кімната 5"
                    class="slider-img"
                />
            </div>
        </div>
    </div>
</section>

