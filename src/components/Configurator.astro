---

---

<section class="configurator-container">
    <div class="configurator-main">
        <h1 class="page-title">Конфігуратор ПК</h1>
        
        <!-- Секція: Базові -->
        <div class="config-section">
            <h2 class="section-heading">Базові <span class="required-asterisk">*</span></h2>
            
            <div class="component-list">
                <!-- Процесор -->
                <div class="component-row" data-type="cpu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <img src="/configurator-icons/procesor.svg" alt="Процесор" class="comp-icon" />
                        </div>
                        <div class="component-details">
                            <span class="component-name">Процесор</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('cpu')">+ Обрати</button>
                </div>

                <!-- Материнська плата -->
                <div class="component-row" data-type="mb">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <img src="/configurator-icons/materinka.svg" alt="Материнська плата" class="comp-icon" />
                        </div>
                        <div class="component-details">
                            <span class="component-name">Материнська плата</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('mb')">+ Обрати</button>
                </div>
                
                <!-- Відеокарта -->
                <div class="component-row" data-type="gpu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <img src="/configurator-icons/videokarta.svg" alt="Відеокарта" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Відеокарта</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('gpu')">+ Обрати</button>
                </div>

                <!-- ОЗП -->
                <div class="component-row" data-type="ram">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <img src="/configurator-icons/moduli_pamyati.svg" alt="Модулі пам'яті" class="comp-icon" />
                        </div>
                        <div class="component-details">
                            <span class="component-name">Модулі пам'яті</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('ram')">+ Обрати</button>
                </div>
            </div>
        </div>

        <!-- Секція: Обов'язкові -->
        <div class="config-section">
            <h2 class="section-heading">Обов'язкові комплектуючі <span class="required-asterisk">*</span></h2>
            <div class="component-list">
                <!-- SSD -->
                <div class="component-row" data-type="ssd">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/ssd.svg" alt="SSD накопичувач" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">SSD накопичувач</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('ssd')">+ Обрати</button>
                </div>
                
                <!-- Охолодження -->
                <div class="component-row" data-type="cooler">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/oholodgennya.svg" alt="Система охолодження" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Система охолодження</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('cooler')">+ Обрати</button>
                </div>
                
                <!-- Блок живлення -->
                <div class="component-row" data-type="psu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/blok_jivlennya.svg" alt="Блок живлення" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Блок живлення</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('psu')">+ Обрати</button>
                </div>
                
                <!-- Корпус -->
                <div class="component-row" data-type="case">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/korpus.svg" alt="Корпус" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Корпус</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('case')">+ Обрати</button>
                </div>
            </div>
        </div>

        <!-- Секція: Додаткові комплектуючі -->
        <div class="config-section">
            <h2 class="section-heading">Додаткові комплектуючі</h2>
            <div class="component-list">
                <!-- HDD -->
                <div class="component-row" data-type="hdd">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/hdd.svg" alt="HDD диск" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Жорсткий диск (HDD)</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('hdd')">+ Обрати</button>
                </div>

                <!-- Звукова карта -->
                <div class="component-row" data-type="sound-cards">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/sound_cards.svg" alt="Звукова карта" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Звукова карта</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('sound-cards')">+ Обрати</button>
                </div>
            </div>
        </div>
        
        <!-- Секція: Периферія -->
        <div class="config-section">
            <h2 class="section-heading">Периферія та аксесуари</h2>
            <div class="component-list">
                <!-- Монітор -->
                <div class="component-row" data-type="monitors">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/monitor.svg" alt="Монітор" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Монітор</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('monitors')">+ Обрати</button>
                </div>

                <!-- Клавіатура -->
                <div class="component-row" data-type="keyboards">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/klaviatura.svg" alt="Клавіатура" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Клавіатура</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('keyboards')">+ Обрати</button>
                </div>

                <!-- Миша -->
                <div class="component-row" data-type="mice">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/misha.svg" alt="Миша" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Миша</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('mice')">+ Обрати</button>
                </div>

                <!-- Гарнітура та навушники -->
                <div class="component-row" data-type="headsets">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/gatnitura.svg" alt="Гарнітура та навушники" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Гарнітура та навушники</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('headsets')">+ Обрати</button>
                </div>

                <!-- Мікрофон -->
                <div class="component-row" data-type="microphones">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/microphone.svg" alt="Мікрофон" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Мікрофон</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('microphones')">+ Обрати</button>
                </div>

                <!-- Геймпад -->
                <div class="component-row" data-type="gamepads">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/gamepad.svg" alt="Геймпад" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Геймпад</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('gamepads')">+ Обрати</button>
                </div>

                <!-- Килимок та аксесуари -->
                <div class="component-row" data-type="accessories">
                    <div class="component-info">
                        <div class="icon-wrapper">
                             <img src="/configurator-icons/kilimok.svg" alt="Килимок та аксесуари" class="comp-icon" />
                        </div>
                         <div class="component-details">
                            <span class="component-name">Килимок та аксесуари</span>
                            <span class="selected-item-name empty-state">Не обрано</span>
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('accessories')">+ Обрати</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Права панель (Підсумок) -->
    <aside class="configurator-sidebar">
        <div class="summary-card">
            <div class="summary-header">
                <h3>Ваша збірка</h3>
                <span class="summary-count" id="summaryCount">0 / 8 обрано</span>
            </div>

            <div class="summary-status" id="statusBox">
                <div class="status-warning">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                        ></path><line x1="12" y1="9" x2="12" y2="13"
                        ></line><line x1="12" y1="17" x2="12.01" y2="17"
                        ></line></svg
                    >
                    <span>Збірка не повна</span>
                </div>
            </div>

            <div class="summary-price-block">
                <span class="total-label">Загальна сума:</span>
                <span class="total-price" id="totalPriceDisplay">0 ₴</span>
            </div>

            <div class="summary-actions">
                <div id="editingStateBanner" class="editing-banner hidden">
                    <div class="editing-banner-content">
                        <span class="editing-badge-tag">Редагування збірки</span>
                        <span class="editing-banner-title" id="editingBannerTitle">Моя збірка</span>
                    </div>
                    <button type="button" id="btnCancelEdit" class="btn-cancel-edit" title="Вийти з режиму редагування">✕ Нова збірка</button>
                </div>

                <button class="btn-buy" id="btnBuyConfig">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><circle cx="9" cy="21" r="1"></circle><circle
                            cx="20"
                            cy="21"
                            r="1"></circle><path
                            d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                        ></path></svg
                    >
                    У кошик
                </button>
                <button class="btn-outline-small" id="btnSaveConfig">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                        ></path><polyline points="17 21 17 13 7 13 7 21"
                        ></polyline><polyline points="7 3 7 8 15 8"
                        ></polyline></svg
                    >
                    <span id="btnSaveConfigText">Зберегти конфігурацію</span>
                </button>
                <button type="button" class="btn-outline-small hidden" id="btnSaveAsNew">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span>Зберегти як нову</span>
                </button>
            </div>

            <div class="service-addon">
                <div class="service-header">
                    <span>Послуга збірки</span>
                </div>
                <div class="service-body">
                    <div class="service-price-box">
                        <span class="price-val">499 ₴</span>
                        <span class="price-plus">+ 1%</span>
                        <span class="price-desc" id="serviceFeeCalc"
                            >від вартості комплектуючих (+ 195 ₴)</span
                        >
                    </div>
                    <p class="service-note" id="serviceNote">
                        Доступно лише для повної та сумісної збірки.
                    </p>
                </div>
            </div>
        </div>
    </aside>
</section>

<!-- Модальне вікно вибору -->
<div id="selectionModal" class="modal-overlay hidden">
    <div class="modal-content">
        <div class="modal-header">
            <div>
                <h3 id="modalTitle">Вибір компонента</h3>
                <span id="modalSubtitle" class="modal-subtitle">Оберіть відповідний товар для вашої збірки</span>
            </div>
            <button class="btn-close-modal" onclick="closeModal()">✕</button>
        </div>
        <div class="modal-body">
            <div id="modalProductsList" class="modal-products-list">
                <!-- Товари завантажуються динамічно -->
            </div>
            <div class="modal-footer-catalog">
                <span>Бажаєте переглянути більше?</span>
                <a id="modalCatalogBtn" href="/catalog/components" class="catalog-sublink" target="_blank">
                    Переглянути всі варіанти в каталозі →
                </a>
            </div>
        </div>
    </div>
</div>

<style is:global>
    .configurator-container {
        display: flex;
        gap: 40px;
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 24px;
        align-items: flex-start;
    }

    .configurator-main {
        flex: 1;
    }

    .page-title {
        font-size: 32px;
        margin-bottom: 40px;
        color: var(--color-text-main);
        font-weight: 700;
    }

    .config-section {
        margin-bottom: 40px;
    }

    .section-heading {
        font-size: 22px;
        margin-bottom: 20px;
        color: var(--color-text-main);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .required-asterisk {
        color: var(--color-accent);
    }

    .component-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .component-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 16px 24px;
        transition: all 0.2s;
    }

    .component-row:hover {
        border-color: #444;
        background-color: #282828;
    }

    .component-row.is-selected {
        border-color: var(--color-accent);
        background-color: rgba(0, 255, 204, 0.03);
    }

    .component-info {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .icon-wrapper {
        width: 56px;
        height: 56px;
        background-color: var(--color-element);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .is-selected .icon-wrapper {
        background-color: rgba(0, 255, 204, 0.1);
        color: var(--color-accent);
    }

    .comp-icon {
        width: 37px;
        height: 37px;
        filter: brightness(0) invert(1);
        opacity: 0.85;
        transition: all 0.2s ease;
    }

    .is-selected .comp-icon {
        opacity: 1;
    }

    .component-details {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .component-name {
        font-weight: 600;
        font-size: 16px;
        color: var(--color-text-main);
    }

    .selected-item-name {
        font-size: 14px;
        color: var(--color-text-muted);
    }

    .empty-state {
        font-style: italic;
        opacity: 0.5;
    }

    .component-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .item-price {
        font-weight: 700;
        font-size: 18px;
        color: var(--color-text-main);
        margin-right: 8px;
    }

    .btn-add {
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-main);
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-add:hover {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: #000;
    }

    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-action:hover {
        background-color: #333;
        color: var(--color-text-main);
    }

    .btn-remove:hover {
        background-color: rgba(255, 77, 77, 0.1);
        color: #ff4d4d;
        border-color: #ff4d4d;
    }

    /* Бічна панель */
    .configurator-sidebar {
        width: 350px;
        position: sticky;
        top: 24px;
    }

    .summary-card {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .summary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 16px;
    }

    .summary-header h3 {
        margin: 0;
        font-size: 18px;
    }

    .summary-count {
        color: var(--color-text-muted);
        font-size: 14px;
    }

    .status-warning {
        display: flex;
        align-items: center;
        gap: 12px;
        background-color: rgba(255, 170, 0, 0.1);
        color: #ffaa00;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 24px;
        border: 1px solid rgba(255, 170, 0, 0.2);
    }

    .summary-price-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 24px;
    }

    .total-label {
        font-size: 14px;
        color: var(--color-text-muted);
    }

    .total-price {
        font-size: 32px;
        font-weight: 800;
        color: var(--color-accent);
    }

    .summary-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 32px;
    }

    .editing-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px;
        background: rgba(0, 255, 204, 0.08);
        border: 1px solid rgba(0, 255, 204, 0.3);
        border-radius: 8px;
    }

    .editing-banner.hidden {
        display: none;
    }

    .editing-banner-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .editing-badge-tag {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-accent);
        letter-spacing: 0.5px;
    }

    .editing-banner-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-cancel-edit {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--color-border);
        color: var(--color-text-muted);
        font-size: 11px;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .btn-cancel-edit:hover {
        background: rgba(255, 77, 77, 0.15);
