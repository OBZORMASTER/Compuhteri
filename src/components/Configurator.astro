    // Стан поточної конфігурації
    const selectedConfig: Record<string, CatalogProduct> = {};

    const modal = document.getElementById("selectionModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalSubtitle = document.getElementById("modalSubtitle");
    const modalProductsList = document.getElementById("modalProductsList");
    const modalCatalogBtn = document.getElementById("modalCatalogBtn");

    const formatPrice = (num: number) => {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " ₴";
    };

    function openModal(type?: string) {
        if (!type || !categoryMap[type]) return;

        const info = categoryMap[type];
        if (modalTitle) modalTitle.textContent = info.title;
        if (modalSubtitle) modalSubtitle.textContent = info.subtitle;
        if (modalCatalogBtn) modalCatalogBtn.setAttribute("href", info.href);

        const products = configuratorCatalog[type] || [];
        if (modalProductsList) {
            if (products.length === 0) {
                modalProductsList.innerHTML = `<div class="empty-modal-notice">Товари для цієї категорії наразі оновлюються. Перейдіть до каталогу.</div>`;
            } else {
                const currentSelected = selectedConfig[type];
                modalProductsList.innerHTML = products.map((prod) => {
                    const isSelected = currentSelected && currentSelected.slug === prod.slug;
                    return `
                        <div class="modal-prod-item ${isSelected ? 'is-current' : ''}">
                            <div class="modal-prod-left">
                                <div class="modal-prod-img-wrap" style="width:56px;height:56px;min-width:56px;max-width:56px;min-height:56px;max-height:56px;flex-shrink:0;overflow:hidden;border-radius:8px;background:#141414;border:1px solid #2e2e2e;display:flex;align-items:center;justify-content:center;padding:4px;">
                                    <img src="${prod.img}" alt="${prod.title}" class="modal-prod-img" width="48" height="48" style="width:48px;height:48px;max-width:48px;max-height:48px;object-fit:contain;display:block;" onerror="this.style.opacity='0.3'" />
                                </div>
                                <div class="modal-prod-info">
                                    <span class="modal-prod-title" title="${prod.title}">${prod.title}</span>
                                    <span class="modal-prod-specs">${prod.specs}</span>
                                </div>
                            </div>
                            <div class="modal-prod-right">
                                <span class="modal-prod-price">${prod.price}</span>
                                <button type="button" class="btn-select-prod ${isSelected ? 'selected' : ''}" onclick="selectComponent('${type}', '${prod.slug}')">
                                    ${isSelected ? '✓ Обрано' : 'Обрати'}
                                </button>
                            </div>
                        </div>
                    `;
                }).join("");
            }
        }

        modal?.classList.remove("hidden");
    }

    function closeModal() {
        modal?.classList.add("hidden");
    }

    function selectComponent(type: string, slug: string) {
        const productList = configuratorCatalog[type];
        if (!productList) return;

        const product = productList.find(p => p.slug === slug);
        if (!product) return;

        selectedConfig[type] = product;

        const row = document.querySelector(`.component-row[data-type="${type}"]`);
        if (row) {
            row.classList.add("is-selected");
            const nameEl = row.querySelector(".selected-item-name");
            if (nameEl) {
                nameEl.textContent = product.title;
                nameEl.classList.remove("empty-state");
            }

            // Заміна кнопки на блок з ціною та діями
            let actionsEl = row.querySelector(".component-actions");
            if (!actionsEl) {
                const addBtn = row.querySelector(".btn-add");
                if (addBtn) addBtn.remove();
                actionsEl = document.createElement("div");
                actionsEl.className = "component-actions";
                row.appendChild(actionsEl);
            }

            actionsEl.innerHTML = `
                <span class="item-price">${product.price}</span>
                <button class="btn-action btn-replace" onclick="openModal('${type}')" title="Замінити">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.59-9.21l5.67-5.67"/></svg>
                </button>
                <button class="btn-action btn-remove" onclick="removeComponent('${type}')" title="Видалити">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            `;
        }

        closeModal();
        updateSummary();
    }

    function removeComponent(type: string) {
        delete selectedConfig[type];

        const row = document.querySelector(`.component-row[data-type="${type}"]`);
        if (row) {
            row.classList.remove("is-selected");
            const nameEl = row.querySelector(".selected-item-name");
            if (nameEl) {
                nameEl.textContent = "Не обрано";
                nameEl.classList.add("empty-state");
            }

            const actionsEl = row.querySelector(".component-actions");
            if (actionsEl) {
                actionsEl.remove();
            }

            const existingAddBtn = row.querySelector(".btn-add");
            if (!existingAddBtn) {
                const addBtn = document.createElement("button");
                addBtn.className = "btn-add";
                addBtn.textContent = "+ Обрати";
                addBtn.setAttribute("onclick", `openModal('${type}')`);
                row.appendChild(addBtn);
            }
        }

        updateSummary();
    }

    function updateSummary() {
        const requiredSlots = ["cpu", "mb", "gpu", "ram", "ssd", "cooler", "psu", "case"];
        const selectedItems = Object.values(selectedConfig);

        const totalPrice = selectedItems.reduce((acc, item) => acc + item.priceNum, 0);
        const totalPriceEl = document.getElementById("totalPriceDisplay");
        if (totalPriceEl) totalPriceEl.textContent = formatPrice(totalPrice);

        const readyRequiredCount = requiredSlots.filter(slot => !!selectedConfig[slot]).length;
        const summaryCountEl = document.getElementById("summaryCount");
        if (summaryCountEl) {
            summaryCountEl.textContent = `${readyRequiredCount} / 8 обрано`;
        }

        const statusBox = document.getElementById("statusBox");
        if (statusBox) {
            if (readyRequiredCount === 8) {
                statusBox.innerHTML = `
                    <div class="status-ready">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <span>Збірка готова до замовлення</span>
                    </div>
                `;
            } else {
                statusBox.innerHTML = `
                    <div class="status-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        <span>Збірка не повна (${8 - readyRequiredCount} обов'язкових залишилось)</span>
                    </div>
                `;
            }
        }

        const feeEl = document.getElementById("serviceFeeCalc");
        if (feeEl) {
            const fee1 = Math.round(totalPrice * 0.01);
            feeEl.textContent = `від вартості комплектуючих (+ ${formatPrice(fee1)})`;
        }
    }

    // Стан редагування існуючої збірки
    let activeEditingId: string | null = null;
    let activeEditingTitle: string | null = null;

    function setEditingMode(id: string | null, title: string | null) {
        activeEditingId = id;
        activeEditingTitle = title;
        const banner = document.getElementById("editingStateBanner");
        const bannerTitle = document.getElementById("editingBannerTitle");
        const btnSaveText = document.getElementById("btnSaveConfigText");
        const btnSaveAsNew = document.getElementById("btnSaveAsNew");

        if (id && title) {
            if (banner) banner.classList.remove("hidden");
            if (bannerTitle) bannerTitle.textContent = title;
            if (btnSaveText) btnSaveText.textContent = "Оновити збережену збірку";
            if (btnSaveAsNew) btnSaveAsNew.classList.remove("hidden");
        } else {
            if (banner) banner.classList.add("hidden");
            if (btnSaveText) btnSaveText.textContent = "Зберегти конфігурацію";
            if (btnSaveAsNew) btnSaveAsNew.classList.add("hidden");
        }
    }

    document.getElementById("btnCancelEdit")?.addEventListener("click", () => {
        setEditingMode(null, null);
    });

    // Автоматичне завантаження конфігурації, переданої з особистого кабінету
    function checkAndLoadInitialConfig() {
        const loadKey = "pcstore_load_config";
        const savedRaw = localStorage.getItem(loadKey);
        if (savedRaw) {
            try {
                const toLoad = JSON.parse(savedRaw);
                localStorage.removeItem(loadKey);
                if (toLoad && typeof toLoad === "object") {
                    let parts: Record<string, any> = {};
                    if (toLoad.parts) {
                        parts = toLoad.parts;
                        setEditingMode(toLoad.id || null, toLoad.title || null);
                    } else {
                        parts = toLoad;
                    }

                    Object.entries(parts).forEach(([type, val]: [string, any]) => {
                        const slug = typeof val === "string" ? val : (val && val.slug ? val.slug : "");
                        if (slug && configuratorCatalog[type]) {
                            selectComponent(type, slug);
                        }
                    });
                }
            } catch (e) {
                // ігноруємо помилки
            }
        }
        updateSummary();
    }

    checkAndLoadInitialConfig();

    // Слухач на кнопку додавання у кошик
    const btnBuy = document.getElementById("btnBuyConfig");
    btnBuy?.addEventListener("click", () => {
        const selectedItems = Object.values(selectedConfig);
        if (selectedItems.length === 0) {
            alert("Будь ласка, оберіть хоча б один компонент перед додаванням у кошик.");
            return;
        }

        let cart: any[] = [];
        try {
            const savedCart = localStorage.getItem("pcstore_cart");
            if (savedCart) {
                cart = JSON.parse(savedCart);
            }
        } catch (e) {
            cart = [];
        }

        selectedItems.forEach(item => {
            const existingIndex = cart.findIndex(c => c.id === item.slug);
            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({
                    id: item.slug,
                    title: item.title,
                    price: item.price,
                    priceNum: item.priceNum,
                    category: item.category,
                    quantity: 1,
                    img: item.img,
                    code: item.code
                });
            }
        });

        localStorage.setItem("pcstore_cart", JSON.stringify(cart));
        window.location.href = "/cart";
    });

    // Допоміжна функція формування даних збереженої збірки
    function prepareConfigPayload() {
        const selectedItems = Object.values(selectedConfig);
        const totalPrice = selectedItems.reduce((acc, item) => acc + item.priceNum, 0);

        const parts: Record<string, string> = {};
        Object.entries(selectedConfig).forEach(([type, prod]) => {
            if (prod && prod.slug) {
                parts[type] = prod.slug;
            }
        });

        const now = new Date();
        const dateStr = `${String(now.getDate()).padStart(2, "0")}.${String(now.getMonth() + 1).padStart(2, "0")}.${now.getFullYear()}`;

        let defaultTitle = "Збірка ПК";
        let cpuShort = "";
        let gpuShort = "";

        if (selectedConfig.cpu) {
            const m = selectedConfig.cpu.title.match(/(Ryzen\s*\d+|Core\s*i\d+)/i);
            cpuShort = m ? m[1] : selectedConfig.cpu.title.replace(/^Процесор\s+/i, "").split(" ")[0];
        }
        if (selectedConfig.gpu) {
            const m = selectedConfig.gpu.title.match(/(RTX\s*\d+(?:\s*Ti|\s*Super)*|RX\s*\d+(?:\s*XT)*)/i);
            gpuShort = m ? m[1] : selectedConfig.gpu.title.replace(/^Відеокарта\s+/i, "").split(" ")[0];
        }

        if (cpuShort && gpuShort) {
            defaultTitle = `Збірка ${cpuShort} / ${gpuShort}`;
        } else if (gpuShort) {
            defaultTitle = `Збірка на ${gpuShort}`;
        } else if (cpuShort) {
            defaultTitle = `Збірка на ${cpuShort}`;
        } else {
            defaultTitle = `Збірка ПК (${dateStr})`;
        }

        const cpuTitle = selectedConfig.cpu?.title ? selectedConfig.cpu.title.replace(/^Процесор\s+/i, "").trim() : "Не обрано";
        const gpuTitle = selectedConfig.gpu?.title ? selectedConfig.gpu.title.replace(/^Відеокарта\s+/i, "").trim() : "Не обрано";
        const ramTitle = selectedConfig.ram?.title ? selectedConfig.ram.title.replace(/^(Оперативна|Модулі)\s+пам['’ʼ]я(ть|ті)\s+/gi, "").trim() : "Не обрано";

        const storages = [
            selectedConfig.ssd?.title ? selectedConfig.ssd.title.replace(/^(Жорсткий диск|SSD накопичувач|HDD накопичувач|SSD|HDD)\s+/gi, "").trim() : "",
            selectedConfig.hdd?.title ? selectedConfig.hdd.title.replace(/^(Жорсткий диск|SSD накопичувач|HDD накопичувач|SSD|HDD)\s+/gi, "").trim() : ""
        ].filter(Boolean);
        const storageTitle = storages.length > 0 ? storages.join(" + ") : "Не обрано";

        return {
            totalPrice,
            parts,
            dateStr,
            defaultTitle,
            cpuTitle,
            gpuTitle,
            ramTitle,
            storageTitle,
        };
    }

    // Зберегти або оновити конфігурацію
    const btnSave = document.getElementById("btnSaveConfig");
    btnSave?.addEventListener("click", () => {
        const selectedItems = Object.values(selectedConfig);
        if (selectedItems.length === 0) {
            alert("Будь ласка, оберіть хоча б один компонент для збереження конфігурації.");
            return;
        }

        localStorage.setItem("pcstore_saved_config", JSON.stringify(selectedConfig));
        const payload = prepareConfigPayload();

        const CONFIGS_STORAGE_KEY = "pcstore_cabinet_configs_v1";
        let existingConfigs: any[] = [];
        try {
            const raw = localStorage.getItem(CONFIGS_STORAGE_KEY);
            if (raw) existingConfigs = JSON.parse(raw);
        } catch {
            existingConfigs = [];
        }

        if (activeEditingId) {
            // Оновлюємо поточну існуючу збірку (без дублювання!)
            const targetIndex = existingConfigs.findIndex((c: any) => c.id === activeEditingId);
            const titleToKeep = activeEditingTitle || payload.defaultTitle;
            const updatedItem = {
                id: activeEditingId,
                title: titleToKeep,
                cpu: payload.cpuTitle,
                gpu: payload.gpuTitle,
                ram: payload.ramTitle,
                storage: payload.storageTitle,
                price: formatPrice(payload.totalPrice),
                updatedAt: payload.dateStr,
                parts: payload.parts,
            };

            if (targetIndex !== -1) {
                existingConfigs[targetIndex] = updatedItem;
            } else {
                existingConfigs.unshift(updatedItem);
            }
        } else {
            // Створюємо нову збірку
            const newId = `cfg-${Date.now()}`;
            const newItem = {
                id: newId,
                title: payload.defaultTitle,
                cpu: payload.cpuTitle,
                gpu: payload.gpuTitle,
                ram: payload.ramTitle,
                storage: payload.storageTitle,
                price: formatPrice(payload.totalPrice),
                updatedAt: payload.dateStr,
                parts: payload.parts,
            };
            existingConfigs.unshift(newItem);
            setEditingMode(newId, payload.defaultTitle);
        }

        try {
            localStorage.setItem(CONFIGS_STORAGE_KEY, JSON.stringify(existingConfigs));
        } catch (e) {
            console.error("Помилка збереження в профіль:", e);
        }

        const btn = btnSave as HTMLButtonElement;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            ${activeEditingId ? "Оновлено в профілі!" : "Збережено в профіль!"}
        `;
        setTimeout(() => {
            btn.innerHTML = originalHtml;
        }, 2200);
    });

    // Кнопка: Зберегти як нову збірку (створення окремої копії)
    document.getElementById("btnSaveAsNew")?.addEventListener("click", () => {
        const selectedItems = Object.values(selectedConfig);
        if (selectedItems.length === 0) return;

        const payload = prepareConfigPayload();
        const newId = `cfg-${Date.now()}`;
        const newTitle = activeEditingTitle ? `${activeEditingTitle} (копія)` : payload.defaultTitle;

        const newItem = {
            id: newId,
            title: newTitle,
            cpu: payload.cpuTitle,
            gpu: payload.gpuTitle,
            ram: payload.ramTitle,
            storage: payload.storageTitle,
            price: formatPrice(payload.totalPrice),
            updatedAt: payload.dateStr,
            parts: payload.parts,
        };

        const CONFIGS_STORAGE_KEY = "pcstore_cabinet_configs_v1";
        let existingConfigs: any[] = [];
        try {
            const raw = localStorage.getItem(CONFIGS_STORAGE_KEY);
            if (raw) existingConfigs = JSON.parse(raw);
        } catch {
            existingConfigs = [];
        }

        existingConfigs.unshift(newItem);
        try {
            localStorage.setItem(CONFIGS_STORAGE_KEY, JSON.stringify(existingConfigs));
        } catch (e) {}

        setEditingMode(newId, newTitle);

        const btnNew = document.getElementById("btnSaveAsNew") as HTMLButtonElement | null;
        if (btnNew) {
            const orig = btnNew.innerHTML;
            btnNew.innerHTML = `✓ Збережено копію!`;
            setTimeout(() => { btnNew.innerHTML = orig; }, 2000);
        }
    });

    (window as any).openModal = openModal;
    (window as any).closeModal = closeModal;
    (window as any).selectComponent = selectComponent;
    (window as any).removeComponent = removeComponent;

    modal?.addEventListener("click", function (e) {
        if (e.target === this) {
            closeModal();
        }
    });
</script>
