---

---

<section class="configurator-container">
    <div class="configurator-main">
        <h1 class="page-title">Конфігуратор ПК</h1>

        <!-- Секція: Базові -->
        <div class="config-section">
            <h2 class="section-heading">
                Базові <span class="required-asterisk">*</span>
            </h2>

            <div class="component-list">
                <!-- Процесор (Приклад вже обраного) -->
                <div class="component-row is-selected" data-type="cpu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="4"
                                    y="4"
                                    width="16"
                                    height="16"
                                    rx="2"
                                    ry="2"></rect><rect
                                    x="9"
                                    y="9"
                                    width="6"
                                    height="6"></rect><line
                                    x1="9"
                                    y1="1"
                                    x2="9"
                                    y2="4"></line><line
                                    x1="15"
                                    y1="1"
                                    x2="15"
                                    y2="4"></line><line
                                    x1="9"
                                    y1="20"
                                    x2="9"
                                    y2="23"></line><line
                                    x1="15"
                                    y1="20"
                                    x2="15"
                                    y2="23"></line><line
                                    x1="20"
                                    y1="9"
                                    x2="23"
                                    y2="9"></line><line
                                    x1="20"
                                    y1="14"
                                    x2="23"
                                    y2="14"></line><line
                                    x1="1"
                                    y1="9"
                                    x2="4"
                                    y2="9"></line><line
                                    x1="1"
                                    y1="14"
                                    x2="4"
                                    y2="14"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Процесор</span>
                            <span class="selected-item-name"
                                >Процесор AMD Ryzen 7 7800X3D 4.2(5.0)GHz</span
                            >
                        </div>
                    </div>
                    <div class="component-actions">
                        <span class="item-price">15 999 ₴</span>
                        <button
                            class="btn-action btn-replace"
                            onclick="openModal('cpu')"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.59-9.21l5.67-5.67"
                                ></path></svg
                            >
                        </button>
                        <button class="btn-action btn-remove">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><line x1="18" y1="6" x2="6" y2="18"
                                ></line><line x1="6" y1="6" x2="18" y2="18"
                                ></line></svg
                            >
                        </button>
                    </div>
                </div>

                <!-- Материнська плата -->
                <div class="component-row" data-type="mb">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="3"
                                    y="3"
                                    width="18"
                                    height="18"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="3"
                                    y1="9"
                                    x2="21"
                                    y2="9"></line><line
                                    x1="9"
                                    y1="21"
                                    x2="9"
                                    y2="9"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Материнська плата</span
                            >
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('mb')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Відеокарта -->
                <div class="component-row" data-type="gpu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="4"
                                    width="20"
                                    height="16"
                                    rx="2"
                                    ry="2"></rect><path
                                    d="M7 15h0M12 15h0M17 15h0"></path><line
                                    x1="8"
                                    y1="4"
                                    x2="8"
                                    y2="20"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Відеокарта</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('gpu')"
                        >+ Обрати</button
                    >
                </div>

                <!-- ОЗП -->
                <div class="component-row" data-type="ram">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="7"
                                    width="20"
                                    height="10"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="6"
                                    y1="7"
                                    x2="6"
                                    y2="17"></line><line
                                    x1="10"
                                    y1="7"
                                    x2="10"
                                    y2="17"></line><line
                                    x1="14"
                                    y1="7"
                                    x2="14"
                                    y2="17"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Модулі пам'яті</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('ram')"
                        >+ Обрати</button
                    >
                </div>
            </div>
        </div>

        <!-- Секція: Обов'язкові -->
        <div class="config-section">
            <h2 class="section-heading">
                Обов'язкові <span class="required-asterisk">*</span>
            </h2>
            <div class="component-list">
                <!-- SSD -->
                <div class="component-row" data-type="ssd">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="6"
                                    width="20"
                                    height="12"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="6"
                                    y1="12"
                                    x2="6.01"
                                    y2="12"></line><line
                                    x1="10"
                                    y1="12"
                                    x2="10.01"
                                    y2="12"></line><line
                                    x1="14"
                                    y1="12"
                                    x2="14.01"
                                    y2="12"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">SSD накопичувач</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('ssd')"
                        >+ Обрати</button
                    >
                </div>

                <!-- HDD -->
                <div class="component-row" data-type="hdd">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><ellipse cx="12" cy="5" rx="9" ry="3"
                                ></ellipse><path
                                    d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"
                                ></path><path
                                    d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"
                                ></path></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">HDD диск</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('hdd')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Охолодження -->
                <div class="component-row" data-type="cooler">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><circle cx="12" cy="12" r="10"></circle><path
                                    d="M12 12 12 2M12 12 21.5 12M12 12 6.5 20.5"
                                ></path></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name"
                                >Система охолодження</span
                            >
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('cooler')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Блок живлення -->
                <div class="component-row" data-type="psu">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="3"
                                    y="6"
                                    width="18"
                                    height="12"
                                    rx="2"
                                    ry="2"></rect><path d="M13 12h2"
                                ></path><path d="M13 8h2"></path><path
                                    d="M13 16h2"></path><path d="M7 12h.01"
                                ></path></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Блок живлення</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('psu')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Корпус -->
                <div class="component-row" data-type="case">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="4"
                                    y="2"
                                    width="16"
                                    height="20"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="12"
                                    y1="18"
                                    x2="12.01"
                                    y2="18"></line><line
                                    x1="8"
                                    y1="6"
                                    x2="16"
                                    y2="6"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Корпус</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('case')"
                        >+ Обрати</button
                    >
                </div>
            </div>
        </div>

        <!-- Секція: Додатково -->
        <div class="config-section">
            <h2 class="section-heading">Додаткові опції</h2>
            <div class="component-list">
                <!-- Вентилятори -->
                <div class="component-row" data-type="fans">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M10.827 16.379a6.082 6.082 0 0 1-8.618-7.042c.521-2.52 2.6-5.018 5.253-5.32 1.35-.153 2.7.275 3.65 1.135M10.828 16.38a6.08 6.08 0 0 0 8.018 2.946c2.316-.967 4.286-3.23 4.225-5.91-.03-1.357-.655-2.617-1.688-3.415M10.828 16.38a6.081 6.081 0 0 1 .6-8.586c1.942-1.637 5.176-2.28 7.643-.918 1.253.69 2.222 1.88 2.6 3.256"
                                ></path><circle cx="12" cy="12" r="2"
                                ></circle></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name"
                                >Корпусні вентилятори</span
                            >
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('fans')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Мережева карта -->
                <div class="component-row" data-type="network">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M5 12.55a11 11 0 0 1 14.08 0"
                                ></path><path d="M1.42 9a16 16 0 0 1 21.16 0"
                                ></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"
                                ></path><line x1="12" y1="20" x2="12.01" y2="20"
                                ></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name"
                                >Мережеві карти (Wi-Fi/LAN)</span
                            >
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('network')"
                        >+ Обрати</button
                    >
                </div>
            </div>
        </div>

        <!-- Секція: Периферія -->
        <div class="config-section">
            <h2 class="section-heading">Периферія</h2>
            <div class="component-list">
                <!-- Монітор -->
                <div class="component-row" data-type="monitor">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="3"
                                    width="20"
                                    height="14"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="8"
                                    y1="21"
                                    x2="16"
                                    y2="21"></line><line
                                    x1="12"
                                    y1="17"
                                    x2="12"
                                    y2="21"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Монітор</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('monitor')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Клавіатура -->
                <div class="component-row" data-type="keyboard">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="4"
                                    width="20"
                                    height="16"
                                    rx="2"
                                    ry="2"></rect><line
                                    x1="6"
                                    y1="8"
                                    x2="6.01"
                                    y2="8"></line><line
                                    x1="10"
                                    y1="8"
                                    x2="10.01"
                                    y2="8"></line><line
                                    x1="14"
                                    y1="8"
                                    x2="14.01"
                                    y2="8"></line><line
                                    x1="18"
                                    y1="8"
                                    x2="18.01"
                                    y2="8"></line><line
                                    x1="8"
                                    y1="12"
                                    x2="8.01"
                                    y2="12"></line><line
                                    x1="12"
                                    y1="12"
                                    x2="12.01"
                                    y2="12"></line><line
                                    x1="16"
                                    y1="12"
                                    x2="16.01"
                                    y2="12"></line><line
                                    x1="7"
                                    y1="16"
                                    x2="17"
                                    y2="16"></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Клавіатура</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('keyboard')"
                        >+ Обрати</button
                    >
                </div>

                <!-- Миша -->
                <div class="component-row" data-type="mouse">
                    <div class="component-info">
                        <div class="icon-wrapper">
                            <svg
                                class="comp-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect x="5" y="2" width="14" height="20" rx="7"
                                ></rect><line x1="12" y1="2" x2="12" y2="12"
                                ></line></svg
                            >
                        </div>
                        <div class="component-details">
                            <span class="component-name">Миша</span>
                            <span class="selected-item-name empty-state"
                                >Не обрано</span
                            >
                        </div>
                    </div>
                    <button class="btn-add" onclick="openModal('mouse')"
                        >+ Обрати</button
                    >
                </div>
            </div>
        </div>
    </div>

    <!-- Права панель (Підсумок) -->
    <aside class="configurator-sidebar">
        <div class="summary-card">
            <div class="summary-header">
                <h3>Ваша збірка</h3>
                <span class="summary-count">1 / 8 обрано</span>
            </div>

            <div class="summary-status">
                <div class="status-warning">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                        ></path><line x1="12" y1="9" x2="12" y2="13"
                        ></line><line x1="12" y1="17" x2="12.01" y2="17"
                        ></line></svg
                    >
                    <span>Збірка не повна</span>
                </div>
            </div>

            <div class="summary-price-block">
                <span class="total-label">Загальна сума:</span>
                <span class="total-price">15 999 ₴</span>
            </div>

            <div class="summary-actions">
                <button class="btn-buy">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><circle cx="9" cy="21" r="1"></circle><circle
                            cx="20"
                            cy="21"
                            r="1"></circle><path
                            d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
                        ></path></svg
                    >
                    У кошик
                </button>
                <button class="btn-outline-small">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                        ></path><polyline points="17 21 17 13 7 13 7 21"
                        ></polyline><polyline points="7 3 7 8 15 8"
                        ></polyline></svg
                    >
                    Зберегти конфігурацію
                </button>
            </div>

            <div class="service-addon">
                <div class="service-header">
                    <span>Послуга збірки</span>
                </div>
                <div class="service-body">
                    <div class="service-price-box">
                        <span class="price-val">499 ₴</span>
                        <span class="price-plus">+ 1%</span>
                        <span class="price-desc"
                            >від вартості комплектуючих</span
                        >
