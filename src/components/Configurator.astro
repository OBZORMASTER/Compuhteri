<script>
    // Проста логіка для модального вікна
    function openModal(type) {
        document.getElementById("selectionModal").classList.remove("hidden");
    }

    function closeModal() {
        document.getElementById("selectionModal").classList.add("hidden");
    }

    // Закриття по кліку поза вікном
    document
        .getElementById("selectionModal")
        .addEventListener("click", function (e) {
            if (e.target === this) {
                closeModal();
