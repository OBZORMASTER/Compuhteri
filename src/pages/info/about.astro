---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Про нас | PC STORE" description="Інформація про магазин комп'ютерної техніки та комплектуючих PC STORE">
  <section class="page-section">
    <div class="container">
      <div class="page-header">
        <span class="badge">Інформація</span>
        <h1>Про <span class="accent">PC STORE</span></h1>
        <p class="subtitle">
          Створюємо продуктивні збірки, підбираємо сумісні комплектуючі та допомагаємо з апгрейдом ПК для геймінгу, роботи й творчості.
        </p>
      </div>

      <div class="stats-grid">
        <div class="card stat-card">
          <div class="stat-value">5+ років</div>
          <div class="stat-label">Досвіду у збірці та тестуванні ПК</div>
        </div>
        <div class="card stat-card">
          <div class="stat-value">100%</div>
          <div class="stat-label">Перевірка сумісності та стрес-тести</div>
        </div>
        <div class="card stat-card">
          <div class="stat-value">24/7</div>
          <div class="stat-label">Онлайн-конфігуратор та каталог</div>
        </div>
      </div>

      <div class="content-grid">
        <div class="card">
          <h2>Чому обирають нас</h2>
          <ul class="check-list">
            <li><strong>Чесний підбір комплектуючих:</strong> радимо рішення під ваші задачі та бюджет без зайвих націнок.</li>
            <li><strong>Акуратний кабель-менеджмент:</strong> кожна збірка проходить перевірку температур і стабільності під навантаженням.</li>
            <li><strong>Офіційна гарантія:</strong> працюємо з перевіреними постачальниками комплектуючих та периферії.</li>
          </ul>
          <div class="actions-row">
            <a href="/configurator" class="btn-primary">Відкрити конфігуратор ПК</a>
            <a href="/catalog" class="btn-secondary">Перейти до каталогу</a>
          </div>
        </div>

        <div class="card">
          <h2>Наші напрямки</h2>
          <p class="card-text">
            Окрім продажу відеокарт, процесорів, накопичувачів та периферії, ми виконуємо професійну збірку комп'ютерів на замовлення, діагностику та модернізацію існуючих систем.
          </p>
          <div class="quick-links">
            <a href="/configurator" class="quick-link">Збірка ПК у конфігураторі →</a>
            <a href="/catalog/prebuild" class="quick-link">Готові збірки ПК →</a>
            <a href="/info/warranty" class="quick-link">Гарантія та повернення →</a>
            <a href="/info/contacts" class="quick-link">Контакти та адреса →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: 48px 0 72px;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .page-header {
    margin-bottom: 36px;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: var(--color-element);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  h1 {
    font-size: 36px;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .accent {
    color: var(--color-accent);
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 17px;
    max-width: 720px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }

  .stat-card {
    text-align: center;
  }

  .stat-value {
    font-size: 28px;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: 6px;
  }

  .stat-label {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
  }

  .card {
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 28px;
  }

  h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }

  .card-text {
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .check-list strong {
    color: var(--color-text-main);
  }

  .actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-primary {
    padding: 12px 20px;
    border-radius: 8px;
    background-color: var(--color-accent);
    color: #000;
    font-weight: 700;
    transition: background-color 0.2s;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn-secondary {
    padding: 12px 20px;
    border-radius: 8px;
    background-color: var(--color-element);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .btn-secondary:hover {
    background-color: var(--color-element-hover);
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-link {
    padding: 12px 14px;
    border-radius: 8px;
    background-color: var(--color-element);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;
  }

  .quick-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 820px) {
    .stats-grid,
    .content-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 28px;
    }
  }
</style>