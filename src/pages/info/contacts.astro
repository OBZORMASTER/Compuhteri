---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Контакти | PC STORE" description="Контактна інформація, адреса та графік роботи PC STORE">
  <section class="page-section">
    <div class="container">
      <div class="page-header">
        <span class="badge">Інформація</span>
        <h1>Наші <span class="accent">контакти</span></h1>
        <p class="subtitle">
          Зв'яжіться з нами для консультації щодо комплектуючих, статусу замовлення або сервісного обслуговування.
        </p>
      </div>

      <div class="contacts-grid">
        <div class="card info-card">
          <div class="info-item">
            <div class="info-title">Адреса</div>
            <div class="info-value">м. Запоріжжя, просп. Соборний, 74</div>
          </div>

          <div class="info-item">
            <div class="info-title">Телефон</div>
            <div class="info-value">
              <a href="tel:+380800112233">+38 (0800) 11-22-33</a>
            </div>
          </div>

          <div class="info-item">
            <div class="info-title">Електронна пошта</div>
            <div class="info-value">
              <a href="mailto:support@pcstore.ua">support@pcstore.ua</a>
            </div>
          </div>

          <div class="info-item">
            <div class="info-title">Графік роботи</div>
            <div class="info-value">Пн–Нд: 10:00 – 20:00</div>
          </div>
        </div>

        <div class="card form-card">
          <h2>Швидке звернення</h2>
          <p class="card-text">Залиште повідомлення — ми підготуємо відповідь у робочий час.</p>

          <form id="contact-form" class="contact-form">
            <div class="field">
              <label for="contact-name">Ваше ім'я</label>
              <input id="contact-name" name="name" type="text" placeholder="Олександр" required />
            </div>

            <div class="field">
              <label for="contact-email">Email або телефон</label>
              <input id="contact-email" name="contact" type="text" placeholder="name@example.com" required />
            </div>

            <div class="field">
              <label for="contact-message">Повідомлення</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Цікавить сумісність комплектуючих або терміни збірки..."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn-submit">Надіслати запит</button>
            <p id="contact-status" class="status-msg" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (statusEl) {
      statusEl.textContent = 'Запит сформовано! Менеджер PC STORE зв’яжеться з вами найближчим часом.';
      statusEl.classList.add('visible');
    }
    form.reset();
  });
</script>

<style>
  .page-section {
    padding: 48px 0 72px;
    min-height: 60vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .page-header {
    margin-bottom: 36px;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background-color: var(--color-element);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  h1 {
    font-size: 36px;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .accent {
    color: var(--color-accent);
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 17px;
    max-width: 680px;
  }

  .contacts-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
  }

  .card {
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 28px;
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .info-value {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .info-value a:hover {
    color: var(--color-accent);
  }

  h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }

  .card-text {
    color: var(--color-text-muted);
    margin-bottom: 20px;
    font-size: 15px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background-color: var(--color-element);
    color: var(--color-text-main);
    font-family: inherit;
    font-size: 15px;
    outline: none;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
  }

  .btn-submit {
    padding: 12px 22px;
    border-radius: 8px;
    border: none;
    background-color: var(--color-accent);
    color: #000;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    align-self: flex-start;
    transition: background-color 0.2s;
  }

  .btn-submit:hover {
    background-color: var(--color-accent-hover);
  }

  .status-msg {
    display: none;
    font-size: 14px;
    color: var(--color-accent);
  }

  .status-msg.visible {
    display: block;
  }

  @media (max-width: 820px) {
    .contacts-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 28px;
    }
  }
</style>