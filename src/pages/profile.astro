---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Особистий кабінет | PC STORE" description="Особистий кабінет: історія замовлень та збережені конфігурації ПК">
  <section class="cabinet-section">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Головна</a>
        <span>›</span>
        <span>Особистий кабінет</span>
      </div>

      <h1 class="cabinet-title">Мій <span class="accent">PC STORE</span></h1>

      <div class="cabinet-layout">
        <!-- Ліва колонка: профіль, навігація, бонуси -->
        <aside class="sidebar">
          <div class="card profile-card">
            <div class="greeting">Доброго дня, <strong>Кирило</strong></div>
            <div class="user-email">kyrylo.pc@example.ua</div>

            <nav class="side-nav" aria-label="Розділи кабінету">
              <button type="button" class="side-link is-active" data-nav="orders">
                Історія замовлень
              </button>
              <button type="button" class="side-link" data-nav="configs">
                Збережені конфігурації
              </button>
              <button type="button" class="side-link" data-nav="profile-info">
                Дані профілю
              </button>
              <a href="/configurator" class="side-link side-link-external">
                Конфігуратор ПК ↗
              </a>
              <a href="/info/warranty" class="side-link side-link-external">
                Гарантія та повернення ↗
              </a>
            </nav>

            <div class="bonus-box">
              <div>
                <div class="bonus-label">Бонусні бали</div>
                <div class="bonus-sub">PC STORE Club</div>
              </div>
              <div class="bonus-value">304</div>
            </div>

            <div class="session-note">
              <span class="dot"></span>
              Сеанс активний (демо-режим)
            </div>
          </div>

          <div class="card extra-card">
            <h2 class="extra-title">Збережені збірки</h2>
            <p class="extra-desc">Швидкий доступ до конфігурацій із конфігуратора ПК.</p>
            <button type="button" class="link-btn" data-nav="configs">
              Перейти до конфігурацій →
            </button>
          </div>
        </aside>

        <!-- Права частина: швидкі картки + історія замовлень / збережені конфігурації -->
        <div class="main-column">
          <div class="summary-strip">
            <button type="button" class="summary-tile is-selected" data-nav="orders">
              <div class="tile-head">
                <div class="tile-icon-box">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </div>
                <span class="tile-title">Історія замовлень</span>
              </div>
              <span id="summary-orders-count" class="tile-meta">3 замовлення</span>
            </button>

            <button type="button" class="summary-tile" data-nav="configs">
              <div class="tile-head">
                <div class="tile-icon-box">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                </div>
                <span class="tile-title">Збережені конфігурації</span>
              </div>
              <span id="summary-configs-count" class="tile-meta">2 збірки</span>
            </button>
          </div>

          <!-- Блок 1: Історія замовлень -->
          <section id="panel-orders" class="card panel is-visible">
            <div class="panel-header">
              <div class="panel-heading-group">
                <span class="panel-badge">Історія замовлень</span>
                <h2>Мої замовлення</h2>
              </div>

              <div class="table-controls">
                <div class="search-box">
                  <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <input
                    id="order-search"
                    type="text"
                    placeholder="Пошук за номером або товаром..."
                    aria-label="Пошук за замовленнями"
                  />
                </div>
                <select id="order-status-filter" class="status-select" aria-label="Фільтр за статусом">
                  <option value="all">Усі статуси</option>
                  <option value="Виконано">Виконано</option>
                  <option value="Доставляється">Доставляється</option>
                  <option value="Скасовано">Скасовано</option>
                </select>
              </div>
            </div>

            <div id="orders-list" class="orders-list"></div>
          </section>

          <!-- Блок 2: Збережені конфігурації -->
          <section id="panel-configs" class="card panel">
            <div class="panel-header">
              <div class="panel-heading-group">
                <span class="panel-badge">Збережені конфігурації</span>
                <h2>Збережені збірки ПК</h2>
              </div>

              <div class="panel-actions">
                <button id="add-config-btn" type="button" class="btn-secondary">
                  + Додати конфігурацію
                </button>
                <a href="/configurator" class="btn-primary">Відкрити конфігуратор</a>
              </div>
            </div>

            <div id="configs-grid" class="configs-grid"></div>
          </section>

          <!-- Блок 3: Дані профілю (заглушка залогіненого клієнта) -->
          <section id="panel-profile-info" class="card panel">
            <div class="panel-header">
              <div class="panel-heading-group">
                <span class="panel-badge">Профіль</span>
                <h2>Дані клієнта</h2>
              </div>
            </div>

            <div class="profile-details-grid">
              <div class="detail-box">
                <div class="detail-label">Ім'я та прізвище</div>
                <div class="detail-value">Кирило Коваленко</div>
              </div>
              <div class="detail-box">
                <div class="detail-label">Телефон</div>
                <div class="detail-value">+38 (067) 000-00-00</div>
              </div>
              <div class="detail-box">
                <div class="detail-label">Місто доставки</div>
                <div class="detail-value">м. Запоріжжя, просп. Соборний, 74</div>
              </div>
              <div class="detail-box">
                <div class="detail-label">Статус акаунту</div>
                <div class="detail-value accent">Авторизовано (демо-профіль)</div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const ORDERS_STORAGE_KEY = 'pcstore_cabinet_orders_v1';
  const CONFIGS_STORAGE_KEY = 'pcstore_cabinet_configs_v1';

  interface OrderProduct {
    id: string;
    title: string;
    priceNum: number;
    code?: string;
    img?: string;
  }

  interface OrderItem {
    id: string;
    countLabel: string;
    items: string[];
    products?: OrderProduct[];
    date: string;
    total: string;
    status: 'Виконано' | 'Доставляється' | 'Скасовано';
    deliveryMethod: string;
  }

  interface SavedConfig {
    id: string;
    title: string;
    cpu: string;
    gpu: string;
    ram: string;
    storage: string;
    price: string;
    updatedAt: string;
  }

  const initialOrders: OrderItem[] = [
    {
      id: '00000343270',
      countLabel: '1 товар',
      items: ['SSD Kingston NV2 1TB M.2 NVMe PCIe 4.0'],
      products: [
        {
          id: 'kingston-nv3-1tb',
          title: 'SSD накопичувач Kingston NV3 1TB M.2',
          priceNum: 2450,
          code: '343270',
          img: '/products_pics/kingston-nv3-1tb-1.jpg',
        },
      ],
      date: 'від 16.05.2026',
      total: '2 450 ₴',
      status: 'Виконано',
      deliveryMethod: 'Нова Пошта — Відділення №12',
    },
    {
      id: '72-00403718',
      countLabel: '2 товари',
      items: [
        'Відеокарта GeForce RTX 4070 Super 12GB',
        'Блок живлення 850W 80+ Gold Modular',
      ],
      products: [
        {
          id: 'asus-rtx-4070',
          title: 'Відеокарта ASUS GeForce RTX 4070 12GB',
          priceNum: 28500,
          code: '407018',
          img: '/products_pics/asus-rtx-4070-1.jpg',
        },
        {
          id: 'msi-mpg-850w',
          title: 'Блок живлення MSI MPG A850G PCIE5 850W',
          priceNum: 3300,
          code: '850018',
          img: '/products_pics/msi-mpg-850w-1.jpg',
        },
      ],
      date: 'від 29.08.2025',
      total: '31 800 ₴',
      status: 'Виконано',
      deliveryMethod: 'Самовивіз — м. Запоріжжя, просп. Соборний, 74',
    },
    {
      id: '72-00125910',
      countLabel: '2 товари',
      items: [
        'Оперативна памʼять DDR5 32GB (2x16GB) 6000MHz',
        'Повітряне охолодження процесора Tower ARGB',
      ],
      products: [
        {
          id: 'kingston-ddr5-32gb',
          title: "Оперативна пам'ять Kingston Fury DDR5 32GB",
          priceNum: 4500,
          code: '125910',
          img: '/products_pics/kingston-ddr5-32gb-1.jpg',
        },
        {
          id: 'deepcool-ak620',
          title: 'Кулер для процесора DeepCool AK620',
          priceNum: 2390,
          code: '620910',
          img: '/products_pics/deepcool-ak620-1.jpg',
        },
      ],
      date: 'від 19.03.2025',
      total: '6 890 ₴',
      status: 'Доставляється',
      deliveryMethod: 'Курʼєрська доставка',
    },
  ];

  const initialConfigs: SavedConfig[] = [
    {
      id: 'cfg-101',
      title: 'Gaming QHD Build',
      cpu: 'AMD Ryzen 7 7800X3D',
      gpu: 'RTX 4070 Ti Super 16GB',
      ram: '32GB DDR5 6000MHz',
      storage: '2TB NVMe Gen4',
      price: '68 400 ₴',
      updatedAt: '15.11.2026',
      parts: {
        cpu: 'amd-ryzen-7',
        gpu: 'asus-rtx-4070',
        ram: 'kingston-ddr5-32gb',
        ssd: 'samsung-990-pro-2tb',
        mb: 'msi-z790',
        psu: 'msi-mpg-850w',
        cooler: 'deepcool-ak620',
        case: 'gamdias-gc7-black',
      },
    },
    {
      id: 'cfg-102',
      title: 'Compact Workstation',
      cpu: 'Intel Core i5-14600KF',
      gpu: 'RTX 4060 Ti 16GB',
      ram: '32GB DDR4 3600MHz',
      storage: '1TB NVMe + 2TB HDD',
      price: '44 900 ₴',
      updatedAt: '02.11.2026',
      parts: {
        cpu: 'intel-core-i7',
        gpu: 'asus-rtx-4070',
        ram: 'kingston-ddr4-16gb',
        ssd: 'kingston-nv3-1tb',
        hdd: 'wd-blue-2tb',
        mb: 'msi-z790',
        psu: 'msi-mpg-850w',
        cooler: 'id-cooling-a400',
        case: 'gamdias-gc7-black',
      },
    },
  ];

  function readStorage<T>(key: string, fallback: T): T {
    try {
      const raw = localStorage.getItem(key);
      if (!raw) {
        localStorage.setItem(key, JSON.stringify(fallback));
        return fallback;
      }
      return JSON.parse(raw) as T;
    } catch {
      return fallback;
    }
  }

  function writeStorage<T>(key: string, value: T): void {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // ігноруємо помилки квоти сховища
    }
  }

  function getPluralWord(count: number, one: string, few: string, many: string): string {
    const mod10 = count % 10;
    const mod100 = count % 100;
    if (mod10 === 1 && mod100 !== 11) return `${count} ${one}`;
    if (mod10 >= 2 && mod10 <= 4 && !(mod100 >= 12 && mod100 <= 14)) return `${count} ${few}`;
    return `${count} ${many}`;
  }

  function formatConfigTitle(title: string): string {
    if (!title) return 'Збірка ПК';
    if (title.includes(' + ') && (title.includes('Ryzen') || title.includes('Core'))) {
      const parts = title.split(' + ');
      const cpuMatch = parts[0].match(/(Ryzen\s*\d+|Core\s*i\d+)/i);
      const gpuMatch = (parts[1] || '').match(/(RTX\s*\d+(?:\s*Ti|\s*Super)*|RX\s*\d+(?:\s*XT)*)/i);
      if (cpuMatch && gpuMatch) {
        return `Збірка ${cpuMatch[1]} / ${gpuMatch[1]}`;
      }
      if (gpuMatch) return `Збірка на ${gpuMatch[1]}`;
      if (cpuMatch) return `Збірка на ${cpuMatch[1]}`;
    }
    return title;
  }

  function cleanSpecVal(text: string): string {
    if (!text) return 'Не обрано';
    return text
      .replace(/^Процесор\s+/i, '')
      .replace(/^Відеокарта\s+/i, '')
      .replace(/^(Оперативна|Модулі)\s+пам['’ʼ]я(ть|ті)\s+/gi, '')
      .replace(/(Жорсткий диск|SSD накопичувач|HDD накопичувач|SSD|HDD)\s+/gi, '')
      .trim();
  }

  function getStatusClass(status: OrderItem['status']): string {
    if (status === 'Виконано') return 'status-done';
    if (status === 'Доставляється') return 'status-transit';
    return 'status-cancel';
  }

  function repeatOrder(orderId: string) {
    const orders = readStorage<OrderItem[]>(ORDERS_STORAGE_KEY, initialOrders);
    const target = orders.find((o) => o.id === orderId);
    if (!target) return;

    let cart: any[] = [];
    try {
      cart = JSON.parse(localStorage.getItem('pcstore_cart') || '[]');
    } catch {
      cart = [];
    }

    const itemsToAdd = (target.products && target.products.length > 0)
      ? target.products
      : target.items.map((it, idx) => ({
          id: `re-${target.id}-${idx}`,
          title: it,
          priceNum: Math.round(parseInt(target.total.replace(/[^\d]/g, ''), 10) / target.items.length) || 1000,
          code: target.id,
          img: '',
        }));

    itemsToAdd.forEach((prod) => {
      const existing = cart.find((c: any) => String(c.id) === String(prod.id));
      if (existing) {
        existing.quantity = (existing.quantity || 1) + 1;
      } else {
        cart.push({
          id: prod.id,
          title: prod.title,
          priceNum: prod.priceNum,
          code: prod.code || '',
          img: prod.img || '',
          quantity: 1,
        });
      }
    });

    localStorage.setItem('pcstore_cart', JSON.stringify(cart));
    window.location.href = '/cart';
  }

  function renderOrdersList() {
    const list = document.getElementById('orders-list');
    const searchInput = document.getElementById('order-search') as HTMLInputElement | null;
    const filterSelect = document.getElementById('order-status-filter') as HTMLSelectElement | null;
    const summaryCount = document.getElementById('summary-orders-count');

    const orders = readStorage<OrderItem[]>(ORDERS_STORAGE_KEY, initialOrders);
    if (summaryCount) {
      summaryCount.textContent = getPluralWord(orders.length, 'замовлення', 'замовлення', 'замовлень');
    }

    if (!list) return;

    const query = (searchInput?.value || '').trim().toLowerCase();
    const statusFilter = filterSelect?.value || 'all';

    const filtered = orders.filter((order) => {
      const matchesStatus = statusFilter === 'all' || order.status === statusFilter;
      const matchesQuery =
        !query ||
        order.id.toLowerCase().includes(query) ||
        order.items.some((item) => item.toLowerCase().includes(query));
      return matchesStatus && matchesQuery;
    });

    if (!filtered.length) {
      list.innerHTML = `
        <div class="empty-box">
          <p>За заданими параметрами замовлень не знайдено.</p>
        </div>
      `;
      return;
    }

    list.innerHTML = filtered
      .map(
        (order) => `
        <article class="order-card">
          <div class="order-card-header">
            <div class="order-card-identity">
              <span class="order-code-badge">№ ${order.id}</span>
              <span class="order-card-date">${order.date}</span>
              <span class="count-pill">${order.countLabel}</span>
            </div>
            <div class="order-card-meta">
              <div class="order-card-price">${order.total}</div>
              <span class="status-badge ${getStatusClass(order.status)}">${order.status}</span>
            </div>
          </div>

          <div class="order-card-body">
            <div class="order-card-section">
              <span class="order-section-title">Склад замовлення:</span>
              <div class="order-chips-wrap">
                ${order.items
                  .map(
                    (it) => `
                  <span class="order-item-chip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    ${it}
                  </span>`
                  )
                  .join('')}
              </div>
            </div>

            <div class="order-card-footer">
              <div class="delivery-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                <span>Спосіб доставки: <strong>${order.deliveryMethod}</strong></span>
              </div>
              <button type="button" class="order-repeat-btn" data-repeat-order="${order.id}" title="Додати товари в кошик та перейти до оформлення">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="1 4 1 10 7 10"></polyline>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
                Повторити замовлення
              </button>
            </div>
          </div>
        </article>
      `
      )
      .join('');

    list.querySelectorAll('[data-repeat-order]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-repeat-order');
        if (id) repeatOrder(id);
      });
    });
  }

  function renderSavedConfigs() {
    const grid = document.getElementById('configs-grid');
    const summaryCount = document.getElementById('summary-configs-count');
    const configs = readStorage<SavedConfig[]>(CONFIGS_STORAGE_KEY, initialConfigs);

    if (summaryCount) {
      summaryCount.textContent = getPluralWord(configs.length, 'збірка', 'збірки', 'збірок');
    }

    if (!grid) return;

    if (!configs.length) {
      grid.innerHTML = `
        <div class="empty-box">
          <p>Збережених конфігурацій поки немає.</p>
          <a href="/configurator" class="btn-primary">Створити у конфігураторі</a>
        </div>
      `;
      return;
    }

    grid.innerHTML = configs
      .map(
        (cfg) => `
        <article class="config-card">
          <div class="config-top">
            <div class="config-title-group">
              <h3 class="config-title" title="${cfg.title}">${formatConfigTitle(cfg.title)}</h3>
              <span class="config-date">Оновлено: ${cfg.updatedAt}</span>
            </div>
            <div class="config-price">${cfg.price}</div>
          </div>

          <div class="config-specs-grid">
            <div class="spec-row">
              <span class="spec-label">Процесор (CPU)</span>
              <span class="spec-val" title="${cfg.cpu}">${cleanSpecVal(cfg.cpu)}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Відеокарта (GPU)</span>
              <span class="spec-val" title="${cfg.gpu}">${cleanSpecVal(cfg.gpu)}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Пам'ять (RAM)</span>
              <span class="spec-val" title="${cfg.ram}">${cleanSpecVal(cfg.ram)}</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Накопичувач</span>
              <span class="spec-val" title="${cfg.storage}">${cleanSpecVal(cfg.storage)}</span>
            </div>
          </div>

          <div class="config-actions">
            <a href="/configurator" class="btn-config-open" data-open-cfg="${cfg.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              Відкрити в конфігураторі
            </a>
            <button type="button" class="btn-config-delete" data-remove-cfg="${cfg.id}" title="Видалити збірку">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              Видалити
            </button>
          </div>
        </article>
      `
      )
      .join('');

    grid.querySelectorAll('[data-open-cfg]').forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-open-cfg');
        const target = configs.find((c) => c.id === id);
        if (target) {
          const partsToLoad = target.parts || {
            cpu: target.cpu && target.cpu.includes('Ryzen') ? 'amd-ryzen-7' : 'intel-core-i7',
            gpu: target.gpu && (target.gpu.includes('9070') || target.gpu.includes('7800')) ? 'radeon-rx-9070' : 'asus-rtx-4070',
            ram: target.ram && target.ram.includes('DDR5') ? 'kingston-ddr5-32gb' : 'kingston-ddr4-16gb',
            ssd: target.storage && target.storage.includes('2TB') ? 'samsung-990-pro-2tb' : 'kingston-nv3-1tb',
            mb: 'msi-z790',
            psu: 'msi-mpg-850w',
            cooler: 'deepcool-ak620',
            case: 'gamdias-gc7-black',
          };
          // Передаємо id та назву збірки для редагування без дублювання
          localStorage.setItem(
            'pcstore_load_config',
            JSON.stringify({
              id: target.id,
              title: target.title,
              parts: partsToLoad,
            })
          );
        }
      });
    });

    grid.querySelectorAll('[data-remove-cfg]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove-cfg');
        const next = readStorage<SavedConfig[]>(CONFIGS_STORAGE_KEY, initialConfigs).filter(
          (item) => item.id !== id
        );
        writeStorage(CONFIGS_STORAGE_KEY, next);
        renderSavedConfigs();
      });
    });
  }

  function switchSection(sectionKey: string) {
    const panels: Record<string, HTMLElement | null> = {
      orders: document.getElementById('panel-orders'),
      configs: document.getElementById('panel-configs'),
      'profile-info': document.getElementById('panel-profile-info'),
    };

    if (!(sectionKey in panels)) return;

    Object.entries(panels).forEach(([key, el]) => {
      if (!el) return;
      el.classList.toggle('is-visible', key === sectionKey);
    });

    document.querySelectorAll('.side-link[data-nav]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-nav') === sectionKey);
    });

    document.querySelectorAll('.summary-tile[data-nav]').forEach((tile) => {
      tile.classList.toggle('is-selected', tile.getAttribute('data-nav') === sectionKey);
    });
  }

  document.querySelectorAll('[data-nav]').forEach((el) => {
    el.addEventListener('click', () => {
      const target = el.getAttribute('data-nav');
      if (target) switchSection(target);
    });
  });

  document.getElementById('order-search')?.addEventListener('input', renderOrdersList);
  document.getElementById('order-status-filter')?.addEventListener('change', renderOrdersList);

  document.getElementById('add-config-btn')?.addEventListener('click', () => {
    const current = readStorage<SavedConfig[]>(CONFIGS_STORAGE_KEY, initialConfigs);
    const idx = current.length + 1;
    current.unshift({
      id: `cfg-${Date.now()}`,
      title: `Конфігурація #${idx}`,
      cpu: 'AMD Ryzen 5 7500F',
      gpu: 'Radeon RX 7800 XT 16GB',
      ram: '32GB DDR5 5600MHz',
      storage: '1TB NVMe PCIe 4.0',
      price: '49 700 ₴',
      updatedAt: '19.11.2026',
      parts: {
        cpu: 'amd-ryzen-7',
        gpu: 'radeon-rx-9070',
        ram: 'kingston-ddr5-32gb',
        ssd: 'kingston-nv3-1tb',
        mb: 'msi-z790',
        psu: 'msi-mpg-850w',
        cooler: 'deepcool-ak620',
        case: 'gamdias-gc7-black',
      },
    });
    writeStorage(CONFIGS_STORAGE_KEY, current);
    renderSavedConfigs();
  });

  renderOrdersList();
  renderSavedConfigs();
</script>

