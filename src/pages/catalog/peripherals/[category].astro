---

<Layout>
    <main class="category-list-container container">
        <div class="breadcrumb">
            <a href="/catalog">Каталог</a> / 
            <a href="/catalog/peripherals">Периферія</a> / 
            <span>{currentTitle}</span>
        </div>

        <div class="catalog-page-header">
            <h1 class="page-title">{currentTitle}</h1>
            <p class="page-subtitle">Оберіть потрібну модель з каталогу PC STORE</p>
        </div>

        <div class="shop-layout">
            <aside class="filters-sidebar">
                <h3>Фільтри</h3>
                
                <div class="filter-group">
                    <span class="filter-title">Параметри / Бренд</span>
                    {currentFilters.length > 0 ? (
                        currentFilters.map((filter) => (
                            <label class="filter-option-row">
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" value={filter.value} /> 
                                    <span>{filter.label}</span>
                                </span>
                                <span class="option-count">{getFilterCount(filter.value)}</span>
                            </label>
                        ))
                    ) : (
                        <p style="font-size: 13px; color: var(--color-text-muted); margin: 0;">Немає доступних фільтрів</p>
                    )}
                </div>

                <div class="filter-group">
                    <span class="filter-title">Ціна (₴)</span>
                    <div class="price-inputs">
                        <input type="number" id="price-min" placeholder="Від" />
                        <input type="number" id="price-max" placeholder="До" />
                    </div>
                </div>

                <button id="apply-filters" class="btn-apply">Застосувати фільтри</button>
                <button id="reset-filters" class="btn-reset">Скинути</button>
            </aside>

            <div class="products-area">
                <div class="products-grid-list" id="products-grid">
                    {categoryProducts.length > 0 ? (
                        categoryProducts.map((prod) => {
                            const imgSrc = prod.img || `/products_pics/${prod.slug}-1.jpg`;
                            return (
                                <div 
                                    class="product-card-item" 
                                    data-brands={JSON.stringify(prod.brands || [])} 
                                    data-specs={JSON.stringify(prod.specs || [])}
                                    data-price={prod.priceNum}
                                    data-slug={prod.slug}
                                >
                                    <div class="product-card-img">
                                        <img
                                            src={imgSrc}
                                            alt={prod.title}
                                            loading="lazy"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
                                        />
                                        <span class="img-fallback-text" style="display: none;">{prod.imgText}</span>
                                    </div>
                                    <div class="product-card-info">
                                        <h3>{prod.title}</h3>
                                        <div class="price">{prod.price}</div>
                                        <button type="button" class="btn-detail">Дивитися товар</button>
                                    </div>
                                </div>
                            );
                        })
                    ) : null}
                </div>

                <div id="no-products-message" class="no-products" style="display: none;">
                    <p>У цій категорії наразі немає товарів з обраним фільтром.</p>
                    <a href="/catalog/peripherals" class="btn-detail" style="display:inline-block; margin-top:10px; text-decoration: none; width: auto; padding: 10px 20px;">Назад до периферії</a>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    const applyBtn = document.getElementById('apply-filters');
    const resetBtn = document.getElementById('reset-filters');
    const productCards = document.querySelectorAll('.product-card-item');
    const minInput = document.getElementById('price-min') as HTMLInputElement;
    const maxInput = document.getElementById('price-max') as HTMLInputElement;
    const noProductsMsg = document.getElementById('no-products-message');

    function filterProducts() {
        const checkedFilters = Array.from(document.querySelectorAll('.filter-checkbox:checked'))
            .map((cb) => (cb as HTMLInputElement).value);
        
        const minPrice = minInput.value ? parseFloat(minInput.value) : 0;
        const maxPriceParsed = maxInput.value ? parseFloat(maxInput.value) : Infinity;

        let visibleCount = 0;

        productCards.forEach((card) => {
            const brandsAttr = card.getAttribute('data-brands') || '[]';
            const specsAttr = card.getAttribute('data-specs') || '[]';
            
            let productBrands: string[] = [];
            let productSpecs: string[] = [];

            try {
                productBrands = JSON.parse(brandsAttr);
                productSpecs = JSON.parse(specsAttr);
            } catch (e) {
                productBrands = [];
                productSpecs = [];
            }

            const price = parseFloat(card.getAttribute('data-price') || '0');

            const matchesFilter = checkedFilters.length === 0 || checkedFilters.some(f => productBrands.includes(f) || productSpecs.includes(f));
            const matchesPrice = price >= minPrice && price <= maxPriceParsed;

            if (matchesFilter && matchesPrice) {
                (card as HTMLElement).style.display = 'flex';
                visibleCount++;
            } else {
                (card as HTMLElement).style.display = 'none';
            }
        });

        if (noProductsMsg) {
            noProductsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const filterParam = urlParams.get('filter');

        if (filterParam) {
            filterParam.split(',').forEach((val) => {
                const targetCheckbox = document.querySelector(`.filter-checkbox[value="${val}"]`) as HTMLInputElement | null;
                if (targetCheckbox) {
                    targetCheckbox.checked = true;
                }
            });
        }

        filterProducts();
    });

    productCards.forEach((card) => {
        card.addEventListener('click', () => {
            const slug = card.getAttribute('data-slug');
            if (slug) {
                window.location.href = `/catalog/product/${slug}`;
            }
        });
    });

    if (applyBtn) {
        applyBtn.addEventListener('click', () => {
            filterProducts();
        });
    }

    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            document.querySelectorAll('.filter-checkbox').forEach((cb) => (cb as HTMLInputElement).checked = false);
            minInput.value = '';
            maxInput.value = '';
            window.history.replaceState({}, '', window.location.pathname);
            filterProducts();
        });
    }
</script>

<style>
