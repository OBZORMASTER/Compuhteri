        background-color: var(--color-accent);
        color: #000;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        margin-bottom: 10px;
        transition: opacity 0.2s;
    }
    .btn-apply:hover { opacity: 0.9; }

    .btn-reset {
        width: 100%;
        background-color: var(--color-element);
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
        padding: 8px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-reset:hover { color: var(--color-text-main); }

    .products-area {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .products-grid-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .product-card-item {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.2s, transform 0.2s;
        cursor: pointer;
    }
    .product-card-item:hover { border-color: var(--color-accent); transform: translateY(-2px); }

    .product-card-img {
        width: 100%;
        height: 160px;
        background-color: var(--color-element);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        font-weight: 600;
        margin-bottom: 16px;
        overflow: hidden;
        padding: 10px;
        box-sizing: border-box;
    }

    .product-card-img img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-card-info h3 { font-size: 16px; color: var(--color-text-main); margin: 0 0 8px; }
    .price { font-size: 20px; font-weight: 800; color: var(--color-accent); margin-bottom: 16px; }

    .btn-detail {
        display: block;
        width: 100%;
        text-align: center;
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-main);
        padding: 10px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .product-card-item:hover .btn-detail {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: #000;
    }

    .no-products {
        width: 100%;
        text-align: center;
        padding: 40px;
        color: var(--color-text-muted);
        background: var(--color-card);
        border-radius: 16px;
        border: 1px solid var(--color-border);
    }

    @media (max-width: 768px) {
        .shop-layout { grid-template-columns: 1fr; }
        .products-grid-list { grid-template-columns: 1fr; }
    }
</style>