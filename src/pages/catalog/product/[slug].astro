const product = slug ? productsDatabase[slug] : null;
const currentCategoryInfo = product ? categoryMap[product.category] : null;
---

<Layout>
    <main class="product-page container">
        <div class="breadcrumb">
            <a href="/catalog">Каталог</a> / 
            <a href="/catalog/components">Комплектуючі</a> / 
            {currentCategoryInfo ? (
                <>
                    <a href={currentCategoryInfo.link}>{currentCategoryInfo.title}</a> / 
                </>
            ) : null}
            <span>{product ? product.title : "Товар не знайдено"}</span>
        </div>

        {product ? (
            <div class="product-grid">
                <div class="product-image-section">
                    <div class="image-placeholder-large">
                        <span>Фото товару</span>
                    </div>
                </div>

                <div class="product-details-section">
                    <span class="product-category-tag">{product.category}</span>
                    <h1 class="product-title">{product.title}</h1>
                    <div class="product-price">{product.price}</div>
                    <p class="product-desc">{product.desc}</p>

                    <div class="specs-box">
                        <h3>Характеристики:</h3>
                        <ul>
                            {product.specs.map((spec) => <li>{spec}</li>)}
                        </ul>
                    </div>

                    <button class="btn-buy">Додати в кошик</button>
                </div>
            </div>
        ) : (
            <div style="text-align: center; padding: 60px 0;">
                <h2>Товар не знайдено</h2>
                <a href="/catalog/components" class="btn-back">Повернутися до комплектуючих</a>
            </div>
        )}
    </main>
</Layout>

<script>
    const pathSegments = window.location.pathname.split('/');
    const currentSlug = pathSegments[pathSegments.length - 1];
    const buyButton = document.querySelector('.btn-buy');

    if (buyButton) {
        buyButton.addEventListener('click', () => {
            const titleElement = document.querySelector('.product-title');
            const priceElement = document.querySelector('.product-price');
            const categoryElement = document.querySelector('.product-category-tag');

            if (!titleElement || !priceElement) return;

            const title = titleElement.textContent?.trim() || '';
            const priceStr = priceElement.textContent?.trim() || '0 ₴';
            const priceNum = parseInt(priceStr.replace(/\D/g, ''), 10) || 0;
            const category = categoryElement ? categoryElement.textContent?.trim() || '' : '';

            const productItem = {
                id: currentSlug,
                title: title,
                price: priceStr,
                priceNum: priceNum,
                category: category,
                quantity: 1,
                img: ""
            };

            let cart = JSON.parse(localStorage.getItem('pcstore_cart') || '[]');
            const existingIndex = cart.findIndex((item: any) => item.id === currentSlug);

            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push(productItem);
            }

            localStorage.setItem('pcstore_cart', JSON.stringify(cart));

            const originalText = buyButton.textContent;
            buyButton.textContent = 'Додано в кошик! ✓';
            (buyButton as HTMLElement).style.backgroundColor = '#10B981';
            (buyButton as HTMLElement).style.color = '#fff';

            setTimeout(() => {
                buyButton.textContent = originalText;
                (buyButton as HTMLElement).style.backgroundColor = '';
                (buyButton as HTMLElement).style.color = '';
            }, 2000);
        });
    }
</script>

<style>
    .product-page { max-width: 1200px; margin: 40px auto 80px; padding: 0 24px; }
    .breadcrumb { font-size: 14px; color: var(--color-text-muted); margin-bottom: 24px; }
    .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--color-accent); }
    .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .image-placeholder-large { width: 100%; height: 420px; background-color: var(--color-card); border: 1px dashed var(--color-border); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-weight: 600; }
    .product-details-section { display: flex; flex-direction: column; gap: 16px; }
    .product-category-tag { display: inline-block; background-color: var(--color-element); color: var(--color-accent); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; width: fit-content; border: 1px solid var(--color-border); }
    .product-title { font-size: 28px; color: var(--color-text-main); margin: 0; font-weight: 700; }
    .product-price { font-size: 32px; font-weight: 800; color: var(--color-accent); }
    .product-desc { color: var(--color-text-muted); font-size: 15px; margin: 0; }
    .specs-box { background-color: var(--color-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 16px 20px; }
    .specs-box h3 { font-size: 16px; color: var(--color-text-main); margin: 0 0 10px; }
    .specs-box ul { margin: 0; padding-left: 20px; color: var(--color-text-muted); font-size: 14px; display: flex; flex-direction: column; gap: 6px; }
    .btn-buy { background-color: var(--color-accent); color: #000; border: none; padding: 16px; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; width: 100%; margin-top: 10px; transition: background 0.2s; }
    .btn-back { display: inline-block; margin-top: 20px; background: var(--color-element); color: var(--color-accent); padding: 10px 20px; border-radius: 8px; text-decoration: none; }
</style>