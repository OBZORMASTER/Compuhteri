export function getStaticPaths() {
    return Object.keys(productsDatabase).map((slug) => ({
        params: { slug },
    }));
}

const product = slug ? productsDatabase[slug] : null;
const productImages: string[] = product
    ? (product.images && product.images.length > 0
        ? product.images
        : product.img
            ? [product.img]
            : [])
    : [];

const currentCategoryInfo = product ? categoryMap[product.category] : null;
const currentSectionInfo = currentCategoryInfo ? sectionMeta[currentCategoryInfo.section] : null;
const showCategoryBreadcrumb = currentCategoryInfo && currentCategoryInfo.section !== "prebuild" && currentCategoryInfo.section !== "laptops" && currentCategoryInfo.section !== "consoles";
---

<Layout>
    <main class="product-page container">
        <div class="breadcrumb">
            <a href="/catalog">Каталог</a> / 
            {currentSectionInfo ? (
                <>
                    <a href={currentSectionInfo.link}>{currentSectionInfo.title}</a> / 
                </>
            ) : (
                <>
                    <a href="/catalog/components">Комплектуючі</a> / 
                </>
            )}
            {showCategoryBreadcrumb ? (
                <>
                    <a href={currentCategoryInfo.link}>{currentCategoryInfo.title}</a> / 
                </>
            ) : null}
            <span>{product ? product.title : "Товар не знайдено"}</span>
        </div>

        {product ? (
            <div class="product-grid">
                <div class="product-image-section">
                    {productImages.length > 0 ? (
                        <div class="gallery-wrapper" data-images={JSON.stringify(productImages)}>
                            <div class="main-image-box" id="gallery-zoom-trigger" title="Натисніть, щоб збільшити">
                                <img
                                    id="gallery-main-img"
                                    src={productImages[0]}
                                    alt={product.title}
                                    class="product-main-img"
                                />

                                <span class="zoom-hint" aria-hidden="true">🔍 Збільшити</span>

                                {productImages.length > 1 && (
                                    <>
                                        <button
                                            type="button"
                                            id="gallery-prev"
                                            class="gallery-nav-btn prev"
                                            aria-label="Попереднє фото"
                                        >
                                            ‹
                                        </button>
                                        <button
                                            type="button"
                                            id="gallery-next"
                                            class="gallery-nav-btn next"
                                            aria-label="Наступне фото"
                                        >
                                            ›
                                        </button>
                                        <div class="gallery-counter" id="gallery-counter">
                                            1 / {productImages.length}
                                        </div>
                                    </>
                                )}
                            </div>

                            {productImages.length > 1 && (
                                <div class="gallery-thumbs" id="gallery-thumbs">
                                    {productImages.map((imgSrc, idx) => (
                                        <button
                                            type="button"
                                            class:list={["thumb-btn", { active: idx === 0 }]}
                                            data-index={idx}
                                            aria-label={`Фото ${idx + 1}`}
                                        >
                                            <img src={imgSrc} alt={`${product.title} — фото ${idx + 1}`} />
                                        </button>
                                    ))}
                                </div>
                            )}
                        </div>
                    ) : (
                        <div class="image-placeholder-large">
                            <span>Фото товару</span>
                        </div>
                    )}
                </div>

                <div class="product-details-section">
                    <span class="product-category-tag">{product.category}</span>
                    <h1 class="product-title">{product.title}</h1>
                    <div class="product-price">{product.price}</div>
                    <p class="product-desc">{product.desc}</p>

                    <div class="specs-box">
                        <h3>Характеристики:</h3>
                        <ul>
                            {product.specs.map((spec) => <li>{spec}</li>)}
                        </ul>
                    </div>

                    <button class="btn-buy" data-img={productImages[0] || ""}>Додати в кошик</button>
                </div>
            </div>
        ) : (
            <div style="text-align: center; padding: 60px 0;">
                <h2>Товар не знайдено</h2>
                <a href="/catalog" class="btn-back">Повернутися до каталогу</a>
            </div>
        )}
    </main>

    {product && productImages.length > 0 && (
        <div
            id="image-lightbox"
            class="lightbox-overlay"
            role="dialog"
            aria-modal="true"
            aria-label={`Збільшене фото: ${product.title}`}
            aria-hidden="true"
        >
            <button
                type="button"
                id="lightbox-close"
                class="lightbox-close-btn"
                aria-label="Закрити збільшене фото"
            >
                ✕
            </button>

            {productImages.length > 1 && (
                <>
                    <button
                        type="button"
                        id="lightbox-prev"
                        class="lightbox-nav-btn prev"
                        aria-label="Попереднє фото"
                    >
                        ‹
                    </button>
                    <button
                        type="button"
                        id="lightbox-next"
                        class="lightbox-nav-btn next"
                        aria-label="Наступне фото"
                    >
                        ›
                    </button>
                </>
            )}

            <div class="lightbox-stage" id="lightbox-stage">
                <img
                    id="lightbox-img"
                    src={productImages[0]}
                    alt={product.title}
                    class="lightbox-img"
                />
            </div>

            {productImages.length > 1 && (
                <div class="lightbox-counter" id="lightbox-counter">
                    1 / {productImages.length}
                </div>
            )}
        </div>
    )}
</Layout>

<script>
    const pathSegments = window.location.pathname.split('/');
    const currentSlug = pathSegments[pathSegments.length - 1];
    const buyButton = document.querySelector('.btn-buy');

    // Логіка галереї зображень та лайтбоксу
    const galleryWrapper = document.querySelector('.gallery-wrapper') as HTMLElement | null;
    const zoomTrigger = document.getElementById('gallery-zoom-trigger');
    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const counterEl = document.getElementById('gallery-counter');
    const thumbBtns = document.querySelectorAll('.thumb-btn');

    const lightbox = document.getElementById('image-lightbox') as HTMLElement | null;
    const lightboxStage = document.getElementById('lightbox-stage');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxCounter = document.getElementById('lightbox-counter');

    if (galleryWrapper && mainImg) {
        let images: string[] = [];
        try {
            images = JSON.parse(galleryWrapper.getAttribute('data-images') || '[]');
        } catch {
            images = [];
        }

        let currentIndex = 0;
        let isTransitioning = false;
        let lastFocusedElement: HTMLElement | null = null;

        function animateImageSwap(imgEl: HTMLImageElement | null, nextSrc: string, direction: number, onDone?: () => void) {
            if (!imgEl) {
                onDone?.();
                return;
            }
            if (imgEl.getAttribute('src') === nextSrc && imgEl.style.opacity !== '0') {
                onDone?.();
                return;
            }

            isTransitioning = true;
            const offset = direction >= 0 ? '14px' : '-14px';
            imgEl.style.opacity = '0';
            imgEl.style.transform = `translateX(${offset}) scale(0.985)`;

            window.setTimeout(() => {
                const applyNewSrc = () => {
                    const enterOffset = direction >= 0 ? '-14px' : '14px';
                    imgEl.style.transition = 'none';
                    imgEl.style.transform = `translateX(${enterOffset}) scale(0.985)`;
                    imgEl.src = nextSrc;

                    void imgEl.offsetWidth;

                    imgEl.style.transition = 'opacity 0.24s ease, transform 0.24s ease';
                    imgEl.style.opacity = '1';
                    imgEl.style.transform = 'translateX(0) scale(1)';

                    window.setTimeout(() => {
                        isTransitioning = false;
                        onDone?.();
                    }, 240);
                };

                if (imgEl.complete && imgEl.naturalWidth > 0 && imgEl.src.endsWith(nextSrc)) {
                    applyNewSrc();
                } else {
                    const preloader = new Image();
                    preloader.onload = applyNewSrc;
                    preloader.onerror = applyNewSrc;
                    preloader.src = nextSrc;
                }
            }, 130);
        }

        function updateGallery(index: number, direction = 1) {
            if (images.length === 0 || !mainImg || isTransitioning) return;
            const targetIndex = (index + images.length) % images.length;
            if (targetIndex === currentIndex) return;

            currentIndex = targetIndex;
            const nextSrc = images[currentIndex];

            if (counterEl) {
                counterEl.textContent = `${currentIndex + 1} / ${images.length}`;
            }
            if (lightboxCounter) {
                lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
            }

            thumbBtns.forEach((btn, idx) => {
                btn.classList.toggle('active', idx === currentIndex);
            });

            animateImageSwap(mainImg, nextSrc, direction);
            if (lightbox && lightbox.classList.contains('is-open') && lightboxImg) {
                animateImageSwap(lightboxImg, nextSrc, direction);
            }
        }

        function openLightbox() {
            if (!lightbox || !lightboxImg || images.length === 0) return;
            lastFocusedElement = document.activeElement as HTMLElement | null;
            lightboxImg.style.transition = 'none';
            lightboxImg.style.opacity = '1';
            lightboxImg.style.transform = 'translateX(0) scale(1)';
            lightboxImg.src = images[currentIndex];
            if (lightboxCounter) {
                lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
            }

            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            lightboxClose?.focus();
        }

        function closeLightbox() {
            if (!lightbox || !lightbox.classList.contains('is-open')) return;
            lightbox.classList.remove('is-open');
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            lastFocusedElement?.focus();
            lastFocusedElement = null;
        }

        prevBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            updateGallery(currentIndex - 1, -1);
        });

        nextBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            updateGallery(currentIndex + 1, 1);
        });

        thumbBtns.forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
                const dir = idx >= currentIndex ? 1 : -1;
                updateGallery(idx, dir);
            });
        });

        zoomTrigger?.addEventListener('click', (e) => {
            const target = e.target as HTMLElement | null;
            if (target?.closest('.gallery-nav-btn')) return;
            openLightbox();
        });

        lightboxClose?.addEventListener('click', closeLightbox);

        lightboxPrev?.addEventListener('click', (e) => {
            e.stopPropagation();
            updateGallery(currentIndex - 1, -1);
        });

        lightboxNext?.addEventListener('click', (e) => {
            e.stopPropagation();
            updateGallery(currentIndex + 1, 1);
        });

        lightbox?.addEventListener('click', (e) => {
            if (e.target === lightbox || e.target === lightboxStage) {
                closeLightbox();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) {
                e.preventDefault();
                closeLightbox();
                return;
            }
            if (images.length <= 1) return;
            if (e.key === 'ArrowLeft') updateGallery(currentIndex - 1, -1);
            if (e.key === 'ArrowRight') updateGallery(currentIndex + 1, 1);
        });
    }

    // Додавання в кошик
    if (buyButton) {
        buyButton.addEventListener('click', () => {
            const titleElement = document.querySelector('.product-title');
            const priceElement = document.querySelector('.product-price');
            const categoryElement = document.querySelector('.product-category-tag');

            if (!titleElement || !priceElement) return;

            const title = titleElement.textContent?.trim() || '';
            const priceStr = priceElement.textContent?.trim() || '0 ₴';
            const priceNum = parseInt(priceStr.replace(/\D/g, ''), 10) || 0;
            const category = categoryElement ? categoryElement.textContent?.trim() || '' : '';
            const imgUrl = buyButton.getAttribute('data-img') || '';

            const productItem = {
                id: currentSlug,
                title: title,
                price: priceStr,
                priceNum: priceNum,
                category: category,
                quantity: 1,
                img: imgUrl
            };

            let cart = JSON.parse(localStorage.getItem('pcstore_cart') || '[]');
            const existingIndex = cart.findIndex((item: any) => item.id === currentSlug);

            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push(productItem);
            }

            localStorage.setItem('pcstore_cart', JSON.stringify(cart));

            const originalText = buyButton.textContent;
            buyButton.textContent = 'Додано в кошик! ✓';
            (buyButton as HTMLElement).style.backgroundColor = '#10B981';
            (buyButton as HTMLElement).style.color = '#fff';

            setTimeout(() => {
                buyButton.textContent = originalText;
                (buyButton as HTMLElement).style.backgroundColor = '';
                (buyButton as HTMLElement).style.color = '';
            }, 2000);
        });
    }
</script>

