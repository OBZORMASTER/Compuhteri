const currentFilters = (category && categoryFilters[category]) ? categoryFilters[category] : [];

interface ComponentItem {
  slug: string;
  title: string;
  price: string;
  brands: string[];
  specs?: string[];
  priceNum: number;
  imgText: string;
  img?: string;
}

// База данных товаров: разделяем бренд(ы) и заводские характеристики (specs)
const database: Record<string, Array<ComponentItem>> = {
  "processors": [
    { slug: "intel-core-i7", title: "Процесор Intel Core i7-14700K", price: "17 999 ₴", brands: ["intel"], priceNum: 17999, imgText: "Intel CPU" },
    { slug: "amd-ryzen-7", title: "Процесор AMD Ryzen 7 7800X3D", price: "19 500 ₴", brands: ["amd"], priceNum: 19500, imgText: "AMD CPU" }
  ],
  "gpus": [
    { slug: "asus-rtx-4070", title: "Відеокарта ASUS GeForce RTX 4070 12GB", price: "28 500 ₴", brands: ["nvidia", "asus"], priceNum: 28500, imgText: "RTX 4070" },
    { slug: "radeon-rx-9070", title: "Відеокарта Gigabyte Radeon RX 9070 16GB", price: "47 069 ₴", brands: ["amd", "gigabyte"], priceNum: 47069, imgText: "RX 9070" }
  ],
  "motherboards": [
