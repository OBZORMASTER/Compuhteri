---
export function getStaticPaths() {
  return [
    { params: { category: "processors" } },
    { params: { category: "motherboards" } },
    { params: { category: "gpus" } },
    { params: { category: "ram" } },
    { params: { category: "ssd" } },
    { params: { category: "hdd" } },
    { params: { category: "cases" } },
    { params: { category: "psu" } },
    { params: { category: "coolers" } },
    { params: { category: "sound-cards" } },
  ];
}
import Layout from "../../../layouts/Layout.astro";

// Получаем подкатегорию из URL (например: processors, gpus, ram и т.д.)
const { category } = Astro.params;

// Красивые заголовки для каждой подкатегории
const categoryTitles: Record<string, string> = {
  "processors": "Процесори",
  "motherboards": "Материнські плати",
  "gpus": "Відеокарти",
