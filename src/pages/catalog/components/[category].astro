    { slug: "kingston-ddr4-16gb", title: "Оперативна пам'ять Kingston Fury DDR4 16GB", price: "2 100 ₴", brands: ["kingston"], specs: ["ddr4-16gb"], priceNum: 2100, imgText: "DDR4 16GB" }
  ],
  "ssd": [
    { slug: "samsung-990-pro-2tb", title: "SSD накопичувач Samsung 990 PRO 2TB M.2", price: "11 800 ₴", brands: ["samsung"], specs: ["2tb"], priceNum: 11800, imgText: "SSD 2TB" },
    { slug: "kingston-nv3-1tb", title: "SSD накопичувач Kingston NV3 1TB M.2", price: "7 500 ₴", brands: ["kingston"], specs: ["1tb"], priceNum: 7500, imgText: "SSD 1TB" }
  ],
  "hdd": [
    { slug: "wd-blue-2tb", title: "Жорсткий диск WD Blue 2TB HDD", price: "7 600 ₴", brands: ["wd"], specs: ["2tb"], priceNum: 7600, imgText: "HDD 2TB" },
    { slug: "toshiba-2tb", title: "Жорсткий диск Toshiba Canvio Basics Exclusive 2TB HDD", price: "5 400 ₴", brands: ["toshiba"], specs: ["2tb"], priceNum: 5400, imgText: "HDD 2TB" },
  ],
  "cases": [
    { slug: "gamdias-gc7-black", title: "Корпус Gamdias Aura GC7 ARGB Black", price: "1 600 ₴", brands: ["gamdias"], specs: ["no-psu", "glass-side"], priceNum: 1600, imgText: "Gamdias Case" }
  ],
  "psu": [
    { slug: "msi-mpg-850w", title: "Блок живлення MSI MPG A850G PCIE5 850W", price: "5 900 ₴", brands: ["msi"], specs: ["850w"], priceNum: 5900, imgText: "PSU 850W" },
    { slug: "kcas-1000w", title: "Блок живлення KCAS PLUS GOLD 1000W", price: "8 709 ₴", brands: ["kcas"], specs: ["1000w"], priceNum: 8709, imgText: "PSU 1000W" },
  ],
  "coolers": [
    { slug: "deepcool-ak620", title: "Кулер для процесора DeepCool AK620", price: "2 600 ₴", brands: ["deepcool"], specs: ["cpu-coolers", "tower"], priceNum: 2600, imgText: "Cooler deepcool" },
    { slug: "id-cooling-a400", title: "Кулер процесорний ID-COOLING Frozn A400 ARGB", price: "1 300 ₴", brands: ["id-cooling"], specs: ["cpu-coolers", "tower"], priceNum: 1300, imgText: "Cooler id-cooling" },
    { slug: "zezzio-prism-6", title: "Вентилятор Zezzio Prism 6 Pro ARGB Ultra Fan Reverse Black", price: "249 ₴", brands: ["zezzio"], specs: ["case-fans"], priceNum: 249, imgText: "Case fan zezzio" },
  ],
  "sound-cards": [
    { slug: "manli-c-media", title: "Звукова карта Manli C-Media 8738 PCI-E", price: "599 ₴", brands: ["manli"], specs: ["in"], priceNum: 599, imgText: "Manli Sound Card" },
    { slug: "vention-sc-2", title: "Звукова карта Vention USB Sound Card 2.0", price: "309 ₴", brands: ["vention"], specs: ["out"], priceNum: 309, imgText: "Vention Sound Card" },
  ]
};

const categoryProducts = (category && database[category]) ? database[category] : [];

// Подсчет количества товаров в текущей категории для каждого фильтра
const getFilterCount = (val: string) =>
  categoryProducts.filter(
    (prod) => (prod.brands || []).includes(val) || (prod.specs || []).includes(val)
  ).length;
---

<Layout>
    <main class="category-list-container container">
        <div class="breadcrumb">
            <a href="/catalog">Каталог</a> / 
            <a href="/catalog/components">Комплектуючі</a> / 
            <span>{currentTitle}</span>
        </div>

        <div class="catalog-page-header">
            <h1 class="page-title">{currentTitle}</h1>
            <p class="page-subtitle">Оберіть потрібну модель з каталогу PC STORE</p>
        </div>

        <div class="shop-layout">
            <!-- Боковая панель фильтров -->
            <aside class="filters-sidebar">
                <h3>Фільтри</h3>
                
                <div class="filter-group">
                    <span class="filter-title">Параметри / Бренд</span>
                    {currentFilters.length > 0 ? (
                        currentFilters.map((filter) => (
                            <label class="filter-option-row">
                                <span class="option-left">
                                    <input type="checkbox" class="filter-checkbox" value={filter.value} /> 
                                    <span>{filter.label}</span>
                                </span>
                                <span class="option-count">{getFilterCount(filter.value)}</span>
                            </label>
                        ))
                    ) : (
                        <p style="font-size: 13px; color: var(--color-text-muted); margin: 0;">Немає доступних фільтрів</p>
                    )}
                </div>

                <div class="filter-group">
                    <span class="filter-title">Ціна (₴)</span>
                    <div class="price-inputs">
                        <input type="number" id="price-min" placeholder="Від" />
                        <input type="number" id="price-max" placeholder="До" />
                    </div>
                </div>

                <button id="apply-filters" class="btn-apply">Застосувати фільтри</button>
                <button id="reset-filters" class="btn-reset">Скинути</button>
            </aside>

            <!-- Сетка товаров -->
            <div class="products-area">
                <div class="products-grid-list" id="products-grid">
                    {categoryProducts.length > 0 ? (
                        categoryProducts.map((prod) => {
                            const imgSrc = prod.img || `/products_pics/${prod.slug}-1.jpg`;
                            return (
                                <div 
                                    class="product-card-item" 
                                    data-brands={JSON.stringify(prod.brands || [])} 
                                    data-specs={JSON.stringify(prod.specs || [])}
                                    data-price={prod.priceNum}
                                    data-slug={prod.slug}
                                >
                                    <div class="product-card-img">
                                        <img
                                            src={imgSrc}
                                            alt={prod.title}
                                            loading="lazy"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
                                        />
                                        <span class="img-fallback-text" style="display: none;">{prod.imgText}</span>
                                    </div>
                                    <div class="product-card-info">
                                        <h3>{prod.title}</h3>
                                        <div class="price">{prod.price}</div>
                                        <button type="button" class="btn-detail">Дивитися товар</button>
                                    </div>
                                </div>
                            );
                        })
                    ) : null}
                </div>

                <!-- Сообщение, если товаров нет вообще в категории или после фильтра -->
                <div id="no-products-message" class="no-products" style="display: none;">
                    <p>У цій категорії наразі немає товарів з обраним фільтром.</p>
                    <a href="/catalog/components" class="btn-detail" style="display:inline-block; margin-top:10px; text-decoration: none; width: auto; padding: 10px 20px;">Назад до комплектуючих</a>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    const applyBtn = document.getElementById('apply-filters');
    const resetBtn = document.getElementById('reset-filters');
    const productCards = document.querySelectorAll('.product-card-item');
    const minInput = document.getElementById('price-min') as HTMLInputElement;
    const maxInput = document.getElementById('price-max') as HTMLInputElement;
    const noProductsMsg = document.getElementById('no-products-message');

    // Функция применения фильтров
    function filterProducts() {
        const checkedFilters = Array.from(document.querySelectorAll('.filter-checkbox:checked'))
            .map((cb) => (cb as HTMLInputElement).value);
        
        const minPrice = minInput.value ? parseFloat(minInput.value) : 0;
        const maxPriceParsed = maxInput.value ? parseFloat(maxInput.value) : Infinity;

        let visibleCount = 0;

        productCards.forEach((card) => {
            // Читаем бренды и характеристики из дата-атрибутов
            const brandsAttr = card.getAttribute('data-brands') || '[]';
            const specsAttr = card.getAttribute('data-specs') || '[]';
            
            let productBrands: string[] = [];
            let productSpecs: string[] = [];

            try {
                productBrands = JSON.parse(brandsAttr);
                productSpecs = JSON.parse(specsAttr);
            } catch (e) {
                productBrands = [];
                productSpecs = [];
            }

            const price = parseFloat(card.getAttribute('data-price') || '0');

            // Товар подходит, если выбранный фильтр есть либо в brands, либо в specs
            const matchesFilter = checkedFilters.length === 0 || checkedFilters.some(f => productBrands.includes(f) || productSpecs.includes(f));
            const matchesPrice = price >= minPrice && price <= maxPriceParsed;

            if (matchesFilter && matchesPrice) {
                (card as HTMLElement).style.display = 'flex';
                visibleCount++;
            } else {
                (card as HTMLElement).style.display = 'none';
            }
        });

        // Показываем или скрываем сообщение об отсутствии товаров
        if (noProductsMsg) {
            if (visibleCount === 0) {
                noProductsMsg.style.display = 'block';
            } else {
                noProductsMsg.style.display = 'none';
            }
        }
    }

    // При загрузке страницы проверяем URL на наличие параметра ?filter=...
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const filterParam = urlParams.get('filter');

        if (filterParam) {
            filterParam.split(',').forEach((val) => {
                const targetCheckbox = document.querySelector(`.filter-checkbox[value="${val}"]`) as HTMLInputElement | null;
                if (targetCheckbox) {
                    targetCheckbox.checked = true;
                }
            });
        }

        filterProducts();
    });

    // Переход на детальную страницу товара при клике на карточку
    productCards.forEach((card) => {
        card.addEventListener('click', () => {
            const slug = card.getAttribute('data-slug');
            if (slug) {
                window.location.href = `/catalog/product/${slug}`;
            }
        });
    });

    // Нажатие на кнопку «Застосувати фільтри»
    if (applyBtn) {
        applyBtn.addEventListener('click', () => {
            filterProducts();
        });
    }

    // Сброс фильтров
    if (resetBtn) {
        resetBtn.addEventListener('click', () => {
            document.querySelectorAll('.filter-checkbox').forEach((cb) => (cb as HTMLInputElement).checked = false);
            minInput.value = '';
            maxInput.value = '';
            
            window.history.replaceState({}, '', window.location.pathname);
            
            filterProducts();
        });
    }
</script>

<style>
    .category-list-container {
        max-width: 1200px;
        margin: 40px auto 80px;
        padding: 0 24px;
    }
    .breadcrumb {
        font-size: 14px;
        color: var(--color-text-muted);
        margin-bottom: 20px;
    }
    .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--color-accent); }
    
    .catalog-page-header { margin-bottom: 32px; }
    .page-title { font-size: 32px; color: var(--color-text-main); margin: 0 0 8px; font-weight: 700; }
    .page-subtitle { color: var(--color-text-muted); margin: 0; font-size: 15px; }

    .shop-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 32px;
    }

    .filters-sidebar {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 24px;
        height: fit-content;
    }
    .filters-sidebar h3 { font-size: 18px; margin: 0 0 20px; color: var(--color-text-main); }
    .filter-group { margin-bottom: 20px; display: flex; flex-direction: column; gap: 10px; }
    .filter-title { font-size: 14px; font-weight: 600; color: var(--color-text-main); margin-bottom: 4px; }

    .filter-option-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 14px;
        color: var(--color-text-muted);
        cursor: pointer;
    }
    .filter-option-row:hover { color: var(--color-text-main); }

    .option-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .option-count {
        font-size: 12px;
        color: var(--color-text-muted);
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        padding: 2px 7px;
        min-width: 24px;
        text-align: center;
    }
    
    .price-inputs { display: flex; gap: 10px; }
    .price-inputs input {
        width: 100%;
        background: var(--color-element);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 8px 12px;
        color: var(--color-text-main);
    }

    .btn-apply {
        width: 100%;
        background-color: var(--color-accent);
        color: #000;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        margin-bottom: 10px;
        transition: opacity 0.2s;
    }
    .btn-apply:hover { opacity: 0.9; }

    .btn-reset {
        width: 100%;
        background-color: var(--color-element);
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
        padding: 8px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-reset:hover { color: var(--color-text-main); }

    .products-area {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .products-grid-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .product-card-item {
        background-color: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.2s, transform 0.2s;
        cursor: pointer;
    }
    .product-card-item:hover { border-color: var(--color-accent); transform: translateY(-2px); }

    .product-card-img {
        width: 100%;
        height: 160px;
        background-color: var(--color-element);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        font-weight: 600;
        margin-bottom: 16px;
        overflow: hidden;
        padding: 10px;
        box-sizing: border-box;
    }

    .product-card-img img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-card-info h3 { font-size: 16px; color: var(--color-text-main); margin: 0 0 8px; }
    .price { font-size: 20px; font-weight: 800; color: var(--color-accent); margin-bottom: 16px; }

    .btn-detail {
        display: block;
        width: 100%;
        text-align: center;
        background-color: var(--color-element);
        border: 1px solid var(--color-border);
        color: var(--color-text-main);
        padding: 10px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .product-card-item:hover .btn-detail {
        background-color: var(--color-accent);
        border-color: var(--color-accent);
        color: #000;
    }

    .no-products {
        width: 100%;
        text-align: center;
        padding: 40px;
        color: var(--color-text-muted);
        background: var(--color-card);
        border-radius: 16px;
        border: 1px solid var(--color-border);
    }

    @media (max-width: 768px) {
        .shop-layout { grid-template-columns: 1fr; }
        .products-grid-list { grid-template-columns: 1fr; }
    }
</style>