---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "PC STORE | Магазин комп'ютерної техніки",
	description = "Магазин комп'ютерної техніки та комплектуючих PC STORE",
} = Astro.props;

import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="uk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>
