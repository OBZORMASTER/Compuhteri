<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: 'Inter', sans-serif;
    padding-top: 60px;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 40px;
    margin-bottom: 60px;
  }

  .logo {
    text-decoration: none;
    font-size: 28px;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: 1px;
    display: inline-block;
    margin-bottom: 16px;
  }

  .logo .accent {
    color: var(--color-accent);
  }

  .brand-desc {
    line-height: 1.6;
    font-size: 15px;
    max-width: 300px;
  }

  .col-title {
    color: var(--color-text-main);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .footer-links,
  .footer-contacts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-links a,
  .footer-contacts a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 15px;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
    padding-left: 6px; 
  }

  .footer-contacts a:hover {
    color: var(--color-accent);
  }

  .footer-contacts li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    line-height: 1.5;
    white-space: nowrap;
  }

  .contact-icon {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 2px;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 24px 0;
    text-align: center;
    font-size: 14px;
    color: #666;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .brand-desc {
      max-width: 100%;
    }
  }
</style>